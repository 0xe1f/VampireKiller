# Copyrighted leftover INCBIN banks - never committed (`make segments`).
# All banks (0-15) are source; no .bin.
segments/*.bin

# ROM-derived scratch — never commit.
# PNGs (gfx/, gfx/sprites/, gfx/tilesets/, gfx/fonts/, minimaps) ARE tracked so they're viewable without a rebuild.
gfx/*.bin
gfx/*.txt
gfx/index.md

# Build output
*.rom

# Toolchain built from source (see README)
tools/sjasmplus

# Local reference clones / scratch
references/

# Temporarily generated files (disassembler scratch, etc.); never committed.
# Regenerate with tools/regen-seg.sh; fold the clean .generated.asm into segNN.asm.
generated/

# Python scratch
tools/__pycache__/
__pycache__/

# OS cruft
.DS_Store
