# Copyrighted leftover INCBIN banks - never committed (`make segments`).
# All banks (0-15) are source; no .bin.
segments/*.bin

# ROM-derived scratch — never commit.
# PNGs (gfx/, gfx/sprites/, gfx/tilesets/, gfx/palettes/, gfx/metatiles/, gfx/fonts/, minimaps) ARE tracked so they're viewable without a rebuild.
gfx/*.bin
gfx/*.txt
gfx/index.md

# Build output
*.rom

# Toolchain built from source (see README)
tools/sjasmplus

# Temporarily generated files (disassembler scratch, etc.); never committed.
# Regenerate with tools/workbench/msx/regen-bank.sh
generated/

# Python scratch
tools/__pycache__/
__pycache__/

# Local CocoaMSX display config (volume, scale, socket).
cocoamsx.json

# OS cruft
.DS_Store

# Workbench skill links (`make skills` / tools/workbench/bin/install-skills).
.cursor/skills/
