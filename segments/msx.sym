; ---- Vampire Killer data (segment 14 @ 0x8000) ----------------------------
scenery_list_ptr: equ 0x8000	; word[hub] -> packed scenery streams
scenery_list_s00: equ 0x800c	; stage 0 courtyard scenery stream
spawn_bitmask_ptr: equ 0x85a6	; word[stage] -> per-room spawn bitmask
object_list_ptr: equ 0x8668	; word[hub] -> packed object streams
credits_font: equ 0x8824		; 14 x 8x8 1bpp ending-credits glyphs (0-9 . ' : ,)
credits_font_az: equ 0x8894		; 26 x 8x8 1bpp glyphs A-Z
sound_tick: equ 0x8964		; IRQ PSG tick (int_handler, segs 14+15 paged)
sound_fade_reload: equ 0x89a0	; C0A5 := 0x3A (fade lo, 0xFF path)
sound_fade_store: equ 0x89a2	; C0A5 := A
sound_run_channels: equ 0x89a5	; tick music A/B/C then fall into sfx slot
sound_ch_dispatch: equ 0x89bc	; call sound_ch_go then the C016 (sfx) slot
sound_ch_go: equ 0x89c6		; C094=A channel, C095=B slot, jp (HL)
sound_idle: equ 0x89ce		; silent-channel tick (all C010..C016 on stop)
sound_idle_slot: equ 0x89dd	; arm this slot with sound_idle_ret + vol 0
sound_idle_arm: equ 0x89e6
sound_idle_ret: equ 0x89f1	; one-shot ret that replaces a live tick ptr
sound_fd_tick: equ 0x89f2	; C098 bit0: jp (C01A)  (play_sound 0xFD)
sound_fb_tick: equ 0x89f6	; C098 bit1: run C018 as slot 4
sound_psg_period: equ 0x89ff	; write 12-bit period DE to PSG (fine=C094*2)
sound_psg_vol: equ 0x8a0b	; write E to PSG amp (reg 8+C094)
sound_mix_mute: equ 0x8a13	; mixer: mute this channel
sound_mix_both: equ 0x8a1a	; mixer: tone + noise
sound_mix_noise: equ 0x8a21	; mixer: noise only
sound_mix_tone: equ 0x8a28	; mixer: tone only
sound_mix_apply: equ 0x8a2c	; apply AND/OR pair from (HL)[C094] to C097 + PSG 7
sound_mix_pair: equ 0x8a35	; AND/OR the mixer shadow from the table row
sound_mix_tone_tbl: equ 0x8a45	; 3 x (AND,OR) enable tone, disable noise
sound_mix_noise_tbl: equ 0x8a4b
sound_mix_both_tbl: equ 0x8a51
sound_mix_mute_tbl: equ 0x8a57
sound_ch_fd: equ 0x8a5d		; play_sound 0xFD channel (IX=0xC080)
sound_ch_a: equ 0x8a64		; music channel A (IX=0xC01C)
sound_ch_b: equ 0x8a6b		; music channel B (IX=0xC030)
sound_ch_c: equ 0x8a72		; music channel C (IX=0xC044)
sound_ch_tick: equ 0x8a76	; common music-channel bytecode tick
sound_ch_duration: equ 0x8a89	; --IX+9; decay, env-hold, or fetch
sound_ch_decay: equ 0x8aa3	; pitched note: volume -- until hold
sound_ch_env_hold: equ 0x8ab3	; rest/env: sfx-style period stream
sound_ch_next: equ 0x8aca	; duration expired -> sound_fetch
sound_fetch: equ 0x8ad0		; next music bytecode at (HL)
sound_note_mul: equ 0x8aeb	; duration = (lo nibble+1) * IX+3
sound_note_go: equ 0x8b04	; apply a pitched note (or env table)
sound_note_load: equ 0x8b27	; period from sound_note_tbl
sound_note_shift: equ 0x8b2d	; extra SRL = drop octaves (IX+7)
sound_note_out: equ 0x8b3c	; write period + volume, mixer = tone
sound_note_vol: equ 0x8b49
sound_note_env: equ 0x8b53	; unpitched: load env stream ptr
sound_env_index: equ 0x8b5d	; hi nibble -> sound_env_ptr word
sound_env_write: equ 0x8b68	; IX+0C/+0D = env ptr
sound_env_alt: equ 0x8b7b	; same, from sound_env_ptr_alt
sound_note_tbl: equ 0x8b81	; 12 PSG periods, one octave (hi nibble of note)
sound_rest: equ 0x8b99		; 0xC0..CF rest: duration only, period 0
sound_rest_mul: equ 0x8ba1	; rest duration = (lo+1) * IX+3
sound_cmd: equ 0x8bb4		; music command (byte >= 0xD0)
sound_loop_set: equ 0x8bd9	; 0xxE loop: store count, jump to addr
sound_loop_skip: equ 0x8be4	; loop count done: skip count+addr
sound_cmd_vol: equ 0x8bed	; other lo: IX+4/+5/+6 envelope
sound_cmd_scale: equ 0x8c06	; 0xD0|n -> IX+3 duration scale
sound_cmd_ext: equ 0x8c0f	; 0xE0|n dispatch
sound_cmd_octave: equ 0x8c42	; E0|0-5: IX+7 = 6-n
sound_cmd_lock: equ 0x8c4c	; E0|6: C0A8=1, block new sfx
sound_cmd_unlock: equ 0x8c54	; E0|B: C0A8=0
sound_cmd_detune: equ 0x8c5b	; E0|7: IX+2 bit6, period +2
sound_cmd_jump: equ 0x8c62	; E0|A: HL = addr
sound_cmd_call: equ 0x8c69	; E0|D: save return in IX+12
sound_cmd_return: equ 0x8c77	; E0|E: restore HL from IX+12
sound_cmd_stop: equ 0x8c80	; lo=F: clear C0A7 live bit, idle
sound_cmd_stop_mask: equ 0x8c87
sound_ch_fb: equ 0x8c95		; play_sound 0xFB channel (IX=0xC06C)
sound_sfx: equ 0x8c9c		; sfx channel tick (IX=0xC058)
sound_sfx_go: equ 0x8ca0	; shared FB/sfx: fetch, idle when done
sound_sfx_fetch: equ 0x8ca7	; sfx bytecode; NC=hold, CY=finished
sound_sfx_op: equ 0x8cb9	; next sfx byte (FF end, FE loop, 1x/2x, else vol)
sound_sfx_nibble: equ 0x8ce1	; high nibble -> volume / env shape
sound_sfx_fade: equ 0x8cf5	; music slots: add C0A6 fade to volume
sound_sfx_fade_ok: equ 0x8d05
sound_sfx_amp: equ 0x8d06	; write amplitude
sound_sfx_tone: equ 0x8d09	; low nibble + next byte -> period
sound_sfx_loop: equ 0x8d18	; 0xFE loop (count, addr)
sound_sfx_loop_set: equ 0x8d24
sound_sfx_loop_skip: equ 0x8d2f
sound_sfx_mix: equ 0x8d38	; 0x2x mixer: mute/noise/tone/both
sound_sfx_mix_tone: equ 0x8d48
sound_sfx_mix_noise: equ 0x8d4e
sound_sfx_mix_both: equ 0x8d59
sound_sfx_mix_done: equ 0x8d5c	; store mixer flags, duration, optional env period
sound_sfx_hold: equ 0x8d8b	; or a / ret (NC, still playing)
sfx_ptr: equ 0x8d8d		; scf/ret (CY, done); play_sound indexes id*2 from here
sfx_tbl: equ 0x8d8f		; word[id 1..0x1D] -> sfx streams
music_ptr: equ 0x8dc9		; 6-byte records, 3 channel ptrs, id 0x80..0x8F
snd_fd_seq: equ 0x9463		; play_sound 0xFD overlay stream
snd_fb_seq: equ 0x948b		; play_sound 0xFB overlay stream
