dracula_blit_eyes_closed: equ 0x69a7	; eyes 2+3 closed (0xBCD8/0xBD58), same dest
dracula_face_rest: equ 0x6334	; event 6: closed mouth + closed eyes
dracula_chunk_vel: equ 0x69eb	; 6 x {Yvel, Xvel} words for actor_dracula_chunk
dracula_palette_stash: equ 0x6a03	; VRAM 0xF680 -> CE60, CE13=0x80
dracula_palette_fade: equ 0x6a15	; fade CE60; Z when CE13 hits 0
