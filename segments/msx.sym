event_dracula_init: equ 0x65d3
event_dracula_chunks: equ 0x65fa	; CE01=2: six defeat chunks, then wait 0x78
event_vscroll: equ 0x6848	; if CE34 set, write CE33 to VDP R23 (credits v-scroll)
dracula_spawn_chunks: equ 0x6856	; six actor_dracula_chunk around (CE0F, Y=0x98)
dracula_chunk_go: equ 0x6874	; type 0x2E tick: ret (integrate only)
dracula_chunk_init: equ 0x69c3	; type 0x2E spawn: shape 0x5A + l69ebh velocity
event_dracula_spawn_bat: equ 0x6a50	; CE36==2: one actor_dracula_bat at (0x80,0x98)
