; MSX / MSX2 BIOS entry points + named Vampire Killer routines for z80dasm.
; Used by tools/regen-seg.sh when regenerating a segment disassembly so BIOS
; calls read as names (e.g. `call ENASLT`) instead of raw addresses.

; ---- MSX main-ROM BIOS jump table ----------------------------------------
CHKRAM: equ 0x0000
SYNCHR: equ 0x0008
RDSLT: equ 0x000c
CHRGTR: equ 0x0010
WRSLT: equ 0x0014
OUTDO: equ 0x0018
CALSLT: equ 0x001c
DCOMPR: equ 0x0020
ENASLT: equ 0x0024
GETYPR: equ 0x0028
CALLF: equ 0x0030
KEYINT: equ 0x0038
INITIO: equ 0x003b
INIFNK: equ 0x003e
DISSCR: equ 0x0041
ENASCR: equ 0x0044
WRTVDP: equ 0x0047
RDVRM: equ 0x004a
WRTVRM: equ 0x004d
SETRD: equ 0x0050
SETWRT: equ 0x0053
FILVRM: equ 0x0056
LDIRMV: equ 0x0059
LDIRVM: equ 0x005c
CHGMOD: equ 0x005f
CHGCLR: equ 0x0062
NMI: equ 0x0066
CLRSPR: equ 0x0069
INITXT: equ 0x006c
INIT32: equ 0x006f
INIGRP: equ 0x0072
INIMLT: equ 0x0075
SETTXT: equ 0x0078
SETT32: equ 0x007b
SETGRP: equ 0x007e
SETMLT: equ 0x0081
CALPAT: equ 0x0084
CALATR: equ 0x0087
GSPSIZ: equ 0x008a
GRPPRT: equ 0x008d
GICINI: equ 0x0090
WRTPSG: equ 0x0093
RDPSG: equ 0x0096
STRTMS: equ 0x0099
CHSNS: equ 0x009c
CHGET: equ 0x009f
CHPUT: equ 0x00a2
LPTOUT: equ 0x00a5
LPTSTT: equ 0x00a8
CNVCHR: equ 0x00ab
PINLIN: equ 0x00ae
INLIN: equ 0x00b1
QINLIN: equ 0x00b4
BREAKX: equ 0x00b7
ISCNTC: equ 0x00ba
CKCNTC: equ 0x00bd
BEEP: equ 0x00c0
CLS: equ 0x00c3
POSIT: equ 0x00c6
FNKSB: equ 0x00c9
ERAFNK: equ 0x00cc
DSPFNK: equ 0x00cf
TOTEXT: equ 0x00d2
GTSTCK: equ 0x00d5
GTTRIG: equ 0x00d8
GTPAD: equ 0x00db
GTPDL: equ 0x00de
TAPION: equ 0x00e1
TAPIN: equ 0x00e4
TAPIOF: equ 0x00e7
TAPOON: equ 0x00ea
TAPOUT: equ 0x00ed
TAPOOF: equ 0x00f0
STMOTR: equ 0x00f3
GICINI2: equ 0x00f6
RIGHTC: equ 0x00fc
LEFTC: equ 0x00ff
UPC: equ 0x0102
TUPC: equ 0x0105
DOWNC: equ 0x0108
TDOWNC: equ 0x010b
SCALXY: equ 0x010e
MAPXYC: equ 0x0111
FETCHC: equ 0x0114
STOREC: equ 0x0117
SETATR: equ 0x011a
READC: equ 0x011d
SETC: equ 0x0120
NSETCX: equ 0x0123
GTASPC: equ 0x0126
PNTINI: equ 0x0129
SCANR: equ 0x012c
SCANL: equ 0x012f
CHGCAP: equ 0x0132
CHGSND: equ 0x0135
RSLREG: equ 0x0138
WSLREG: equ 0x013b
RDVDP: equ 0x013e
SNSMAT: equ 0x0141
PHYDIO: equ 0x0144
FORMAT: equ 0x0147
ISFLIO: equ 0x014a
OUTDLP: equ 0x014d
GETVCP: equ 0x0150
GETVC2: equ 0x0153
KILBUF: equ 0x0156
CALBAS: equ 0x0159
; ---- MSX2 extended BIOS ----
SUBROM: equ 0x015c
EXTROM: equ 0x015f
CHKSLZ: equ 0x0162
CHKNEW: equ 0x0165
EOL: equ 0x0168
BIGFIL: equ 0x016b
NSETRD: equ 0x016e
NSTWRT: equ 0x0171
NRDVRM: equ 0x0174
NWRVRM: equ 0x0177

; ---- Vampire Killer resident routines (segment 0) ------------------------
int_handler: equ 0x4028	; timer-interrupt (H.TIMI) service routine
ADD_HL_A: equ 0x4061	; HL += A (unsigned)
ADD_DE_A: equ 0x4066	; DE += A (unsigned)
DISPATCH_A: equ 0x406b	; jump via inline word table indexed by A
init: equ 0x4075	; cartridge entry point
reset_run_state: equ 0x44cd	; wipe run work RAM (0xC405..0xDFFF) + seed defaults
run_seed_tbl: equ 0x44f0	; new-game C410..C412: lives=3, STAGE=0, C412=1
add_score_c0: equ 0x44f3	; ld c,0 then add_score (jp here with DE=amount)
draw_hearts_hud: equ 0x456d	; draw HEART counter (0xC417, BCD) to HUD
add_hearts: equ 0x459b	; add B hearts to 0xC417 (BCD, clamp 99); B=1 small, B=5 large
spend_hearts: equ 0x45a7	; subtract B hearts from 0xC417 (BCD, floor 0)
draw_lives_hud: equ 0x4575	; draw LIVES counter (0xC410, BCD) to HUD
draw_health_bar: equ 0x45d8	; draw HEALTH bar from 0xC415
draw_enemy_meter: equ 0x45ec	; draw ENEMY/BOSS energy meter from 0xC418
restore_health: equ 0x460c	; 0xC415 += B, clamp to 0x20
damage_health: equ 0x4632	; 0xC415 -= B, floor 0
door_blit_tiles: equ 0x5403	; paint 6 stacked 8x8 door tiles at (C5AD=Y, C5AE=X); C5AC:=1
load_weapon_sprites: equ 0x559a	; C416 2/3/4: RLE projectile patterns from seg10 to 0xF8C0
weapon_sprite_ptr: equ 0x55de	; word[C416-2] knife/axe/cross streams
load_vdoor_sprites: equ 0x55f3	; vertical-door extra patterns (C5AC==5) + door SAT
load_simon_sprites: equ 0x56e8	; refresh Simon's 2 sprite cells (legs 0xA281/C42E, torso+whip 0xA2D1/C42F)
load_stage_tileset: equ 0x5653	; blit tileset_ptr[D000] (0xBF 8x8 4bpp) to VRAM 0x8004
tileset_ptr: equ 0x5749	; word[stage 0..18] -> uncompressed tileset in seg4-8
; tileset_s00 @ 0x6000 (seg4) omitted: collides with mtile_rowbase (seg11)
; tileset_s13 @ 0x8000 (seg7) omitted: collides with scenery_list_ptr (seg14)
tileset_s01: equ 0x7220	; stages 1-3 (seg4, spills into seg5)
tileset_s07: equ 0x8493	; stages 7-9 (seg5)
tileset_s04: equ 0x95b3	; stages 4-6 (seg5, spills into seg6)
tileset_s10: equ 0x9e73	; stages 10-12 (seg5, spills into seg6)
tileset_s16: equ 0x9640	; stages 16-17 (seg7, spills into seg8)
tileset_s18: equ 0xa4c0	; stage 18 (seg8)
hud_weapon_key_tiles: equ 0xb9c8	; HUD keys/weapons 8x8 4bpp (seg6)
title_logo_jp_tiles: equ 0xaea0	; title kana glyphs (seg8)
title_logo_en_tiles: equ 0xb260	; title CASTLEVANIA glyphs (seg8)
title_castle_tiles: equ 0xac80	; 0x11 shared castle emblem glyphs (seg8)
hud_font: equ 0xbd80		; 48 x 8x8 1bpp HUD/title glyphs ('0'-'_') (seg8)
hud_font_solid: equ 0xbed8	; all-1s glyph; hud_font_load blits ink 0 to (0,0) for space
hud_tile_bf00: equ 0xbf00	; 8x8 4bpp follow-on (hud_font_load -> VRAM 0xA440)
dracula_portrait_load: equ 0x5887	; event-6: seg15 frame+face tiles into page-1 atlas (s18r9)
dracula_portrait_palette: equ 0x59f3	; event-6: HUD-fixed then 0xBF6F pink/flesh (replaces s18 purple)
dracula_portrait_parts_load: equ 0x5992	; 8 x 16x16 eyes/mouth to page-1 Y=0xA0
dracula_portrait_parts_mirror: equ 0x599d	; H-mirror mouth tiles 4-7 to X=128
dracula_body_load: equ 0x57e6	; event-6: unpack figure 32x32 cloak/chest to page-1 Y=0x80
dracula_body_vram: equ 0x5816	; 32x32 from 0xE800 to VRAM DE
dracula_body_unpack: equ 0x5834	; packed 4bpp rows (N zeros + 12-N + 4 zeros) -> 0xE800
dracula_body_hflip: equ 0x5858	; H-mirror the 32x32 at 0xE800
main_tick: equ 0x414d	; top-level per-frame state machine (from int_handler)
vram_write: equ 0x467c	; CPU RAM -> VRAM via OTIR (HL dest, DE src after ex)
vdp_set_write: equ 0x46b6	; set VDP VRAM write pointer from HL (R14 + bit6)
vdp_set_read: equ 0x46d5	; set VDP VRAM read pointer from HL (R14, no bit6)
rle_dec_addr: equ 0x46f2	; RLE unpack; dest word taken from the stream
rle_dec: equ 0x46f8	; RLE unpack DE -> VRAM HL (0 / 80-addr / run / literal)
gfx_script_run: equ 0x471b	; gfx-script walk: 0=RLE, 1=gfx_script_convert, 2+=copy, FF=end
gfx_script_convert: equ 0x4745	; cmd 1: 1bpp sprite convert via 0xE800 then vram_write
gfx_script_rle: equ 0x4735	; cmd 0: src word, VRAM dest word -> rle_dec
gfx_script_copy: equ 0x4772	; cmd 2+: 6-byte VRAM blit (vram_write)
palette_set: equ 0x481b	; write one MSX2 palette entry A=index, D=0rrr0bbb, E=g
palette_apply: equ 0x4845	; apply (index,rb,g)+ table at HL, 0xFF-terminated
video_init: equ 0x4b60	; SCREEN 5 + clear VRAM pages 0/1
page_play_banks: equ 0x533d	; restore play banks: seg1/2/3 at 6000/8000/A000
page_sound_banks: equ 0x5357	; page seg14/15 at 8000/A000
page_map_banks: equ 0x5369	; page seg11/12/13 (map + Simon RLE)
page_title_banks: equ 0x5381	; page seg9/10 at 8000/A000
page_tileset_late: equ 0x5393	; page seg7/8 (stage >= 13 tilesets)
page_tileset_banks: equ 0x53a5	; page seg4/5/6 (early-stage tilesets)
palette_hud_load: equ 0x572e	; load the 8 fixed HUD/sprite colours from hud_fixed_palette
play_tick: equ 0x5c2c	; in-stage play loop: events, actors, SAT, pause, credits
room_gfx_load: equ 0x5787	; 9AB0[D000-1][D001]: gfx_script_run then palette_apply
vdp_hmmm: equ 0x494d	; V9938 HMMM: HL=SX,SY DE=DX,DY BC=NX,NY; A=pages
vdp_lmmm: equ 0x49e2	; V9938 LMMM (colour-0 skip); A packed pages+logic
vdp_cmd_wait: equ 0x4853	; spin until S#2 bit0 (CE) clears
vdp_status_read: equ 0x485c	; read status register A via R15, then restore R15=0
vdp_line_h: equ 0x487c	; LINE: H=X L=Y B=length C=colour (MAJ 0, along X)
vdp_line_v: equ 0x48af	; LINE with MAJ 1 (along Y); same H/L/B/C
vdp_box: equ 0x48e3	; rectangle outline: H=X L=Y D=width E=height C=colour
vdp_line_v_save: equ 0x48fd	; vdp_line_v preserving HL/DE/BC
vdp_line_h_save: equ 0x4907	; vdp_line_h preserving HL/DE/BC
vdp_hmmv: equ 0x4911	; HMMV fill: H=X L=Y D=page B=w C=h A=byte (0 = 256)
vdp_hmmc: equ 0x4991	; HMMC: CPU bytes at HL -> rect D,E size B,C page A
glyph_blit_run: equ 0x4a2e	; blit B 8x8 1bpp glyphs at D,E in ink C
glyph_blit: equ 0x4a37	; one glyph: expand to 0xC110 then blit to the bitmap
vram_blit_tile8: equ 0x4a58	; one 8x8 4bpp tile, HL src -> DE VRAM (0x80 stride)
vram_blit_tile_run: equ 0x4a6d	; B consecutive 8x8 tiles, wrapping each 0x80 line
vram_blit_tile16: equ 0x4a82	; one 16x16 4bpp tile (16 rows of 8)
glyph_expand_4bpp: equ 0x4aac	; 8x8 1bpp at HL -> 4bpp scratch 0xC110, ink C
tile_atlas_pos: equ 0x4b48	; tile id A -> H=SX=(A&1F)*8, L=SY=(A&E0)>>2
blit_advance_x: equ 0x4b56	; step D,E one 8x8 cell right, wrap to the next row
hud_draw_all: equ 0x451a	; repaint the whole HUD (labels, counters, meters, icons)
draw_stage_hud: equ 0x4542	; draw the HUD STAGE number (0xC411, BCD)
hud_panel_frames: equ 0x454c	; three vdp_box outlines along the top HUD row
hud_bars_redraw: equ 0x45b7	; repaint both HUD meters with their frames
health_bar_redraw: equ 0x45c0	; health frame + draw_health_bar
enemy_meter_frame: equ 0x45c6	; clear + border the enemy meter panel (66x6)
health_bar_frame: equ 0x45cf	; clear + border the health bar panel (66x6)
add_score: equ 0x44f5	; add C:D:E (BCD hi:mid:lo) to the 3-byte score at 0xC405-0xC407
state_hub_advance: equ 0x4324	; C409: boss-clear/credits -> hub++ then advance_stage
state_pause: equ 0x43e1	; C40A: F1 freeze; F1 again resumes play
damage_enemy: equ 0x4643	; 0xC418 enemy/boss energy -= B (floored at 0)
hurt_simon_contact: equ 0x8173	; Simon -= 2*l81d5h[type].odd on enemy contact (shield halves)
hurt_simon_projectile: equ 0x85ad	; Simon -= 8/16 from a 0xC580 hazard slot, sets hurt state
weapon_hit_damage: equ 0x7e33	; whip/sub-weapon damage to enemy 0xC418 (per weapon+type table)
advance_stage: equ 0x434e	; next stage: 0xD000++ (stage), 0xD001=0 (room), bump 0xC410/11, transition 4
room_map_build: equ 0x4fb6	; expand a room's 8x6 metatiles (4x4 tiles ea) into the 0xD100 tile map
frontend_input: equ 0x4398	; after logo/title/attract: SPACE/TRG start, else any press -> title
frontend_to_title: equ 0x43c1	; logo/attract any new-press -> C000=1, title_build
frontend_game_start: equ 0x43cb	; E600 path: seed E604-E607, C000=13 (password/new-game)
title_build: equ 0x4d4e	; build/redraw the title screen (regional JP vs export logo via 0x002B)
title_load_tiles: equ 0x5a02	; load title glyphs into VRAM (JP kana vs VAMPIRE KILLER by 0x002B)
title_castle: equ 0x4c3f	; title_layout: castle emblem (drawn in both regions)
title_logo_jp: equ 0x4c5a	; title_layout: Japanese title "Akumajo Dracula"
title_logo_intl: equ 0x4ca0	; title_layout: export title "VAMPIRE KILLER"
slot_sig_7ffa: equ 0x5cf0	; 6-byte ROM signature compared at CPU 0x7FFA (RDSLT)
scenery_load: equ 0x5a50	; unpack scenery_list into 0xE000, vendor index into 0xDE00
scenery_unpack: equ 0x5a63	; expand scenery stream (0xFE/0xFF/0x00) into 0xE000
scenery_list_lookup: equ 0x5a9f	; HL -> scenery stream for stage 0 or hub 0xD002
vendor_offer_id: equ 0x5b12	; vendor attr bits5-2 -> bonus id (DE00 compact)
scenery_room_load: equ 0x5b22	; current E000 room -> C470/C500/C5B5
scenery_room_ptr: equ 0x5bd6	; HL -> this room's 24-byte slot in 0xE000
scenery_stage_ofs: equ 0x5c0b	; stage 1-18: (stage-within-hub)*0x18
scenery_pos_xy: equ 0x5c1d	; pos byte -> C=Y, B=X pixels
read_buttons: equ 0x4bc2	; joystick|kbd row 8 -> A; play C007/C006, title C401/C400
input_edge: equ 0x4bbb	; A=sample, (HL)=held, (HL-1)=rising-edge bits
read_fkeys: equ 0x4bfb	; sample kbd row 6 -> bit0=F1,bit1=F2,bit2=F3 (edge-detected into 0xC00B)
play_sound: equ 0x50a6	; A=id: 0=stop, 1-7F sfx, 80-8F music, FB-FF special
credits_font_load: equ 0x53e5	; page seg14/15 and blit ending credits_font + _az
credits_font_blit: equ 0x53e8	; blit only (banks already paged)
hud_font_load: equ 0x53bd	; page seg7/8 and blit hud_font + hud_tile_bf00
logo_font_load: equ 0x5316	; page seg13, blit logo_font, fall into page_play_banks
room_spawner: equ 0x5ebf	; per-frame enemy spawner; spawn_bitmask_ptr[stage][room]
zombie_generator: equ 0x9ced	; room_spawner bit0: rate-gated zombie (actor type 01) spawner
merman_generator: equ 0x9d52	; room_spawner bit1: actor_merman_green type 02 (1 HP)
merman_generator_3: equ 0x9d59	; room_spawner bit2: actor_merman_red type 03 (spit, 2 HP)
hanging_bat_generator: equ 0x9d9e	; room_spawner bit3: hanging bat type 04
flying_skull_generator: equ 0x9dca	; room_spawner bit4: flying skull type 07
ghost_head_generator: equ 0x9ddc	; room_spawner bit5: ghost head type 08
roc_generator: equ 0x9dee	; room_spawner bit6: roc type 0x0F (drops 0x23)
spawn_actor: equ 0x5f24	; alloc a free actor slot (7 @ 0xC800, stride 0x80) + init
spawn_actor_init: equ 0x5f7e	; init tail of spawn_actor

; ---- Vampire Killer banked routines (segment 1 @ 0x6000) -----------------
konami_logo_draw: equ 0x6209	; draw Konami logo + seed the top-to-bottom wipe
konami_logo_step: equ 0x6253	; reveal one more row of the logo (poll 0xC422)
object_list_load: equ 0x615b	; page seg14, unpack 3 streams into DB00/DC00/DD00
object_list_unpack: equ 0x6188	; expand (id,attr) stream into 4-byte slots
object_list_lookup: equ 0x61a5	; HL -> this stage's packed object data in seg14
object_list_clear: equ 0x61b0	; clear the 0xDB00 object list
tile_string_draw: equ 0x6276	; tile-id stream at HL to screen pos DE (FF/FE)
cell_event_set: equ 0x633a	; CE00 from l6376h[stage] if column matches
actor_state_reset: equ 0x6389	; clear C470-C6FF + actor/shot lists, reload room
mem_clear_stride: equ 0x63b8	; zero B entries at HL, stride DE
simon_block_clear: equ 0x63be	; clear 0xC420..0xC46F
sprites_hide: equ 0x63cc	; hide all 32 hardware sprites (Y=0xE0)
simon_spawn_pos: equ 0x6409	; Simon Y/X/facing from l6426h[stage]
pattern_phase_upload: equ 0x6591	; phase-selected pattern rows to VRAM 0xF400
pattern_shadow_blit: equ 0x65ab	; copy 0xD400 shadow (0x280 bytes) to VRAM 0xF400
room_edge_detect: equ 0x7682	; set C41B pending exit from Simon vs screen edges
actor_sat_build: equ 0x644c	; one actor: seg6 shape stream -> SAT block at slot|0x20
shot_sat_emit: equ 0x64ec	; 8 x shot SAT blocks -> 0xD638 hardware shadow
c800_sat_emit: equ 0x64f3	; 7 x C800 SAT blocks -> 0xD638 hardware shadow
actor_sat_emit: equ 0x6508	; one actor SAT block -> 0xD638
lookup_word_tbl: equ 0x6549	; DE = ((word*)DE)[A]  (generic word-table lookup)
frame_vram_refresh: equ 0x6552	; per-frame pattern upload (or pattern_shadow_blit)
credits_tick: equ 0x66c1	; ending credits (CE40 after event 6); 4-step machine
credits_start: equ 0x66d0	; BGM 0x8E + credits_init
credits_next: equ 0x66d8	; CE40++
credits_pump: equ 0x66dd	; credits_frame until CE32
credits_wait: equ 0x66e7	; wait 0x5310, arm CE02
credits_finish: equ 0x66f8	; C409 + D012++ + R23=0
credits_init: equ 0x6719	; credits_font_load, clear CE30-CE34
credits_frame: equ 0x6736	; clock + keyframe + wipe
credits_clock: equ 0x673f	; CE33++ every 4th frame
credits_keyframe: equ 0x674a	; blit credits_script_ptr[CE31] when tick matches
credits_script_done: equ 0x6788	; CE32=1, play_sound 0xFF
credits_script_ptr: equ 0x6795	; 43 words -> seg8 ending + seg5 staff keyframes
credits_wipe: equ 0x6831	; FILVRM 0x80 at (CE33-2)<<7 (clear scrolled-off line)
event_dracula: equ 0x65b7	; CE00=6: 11-step CE01 machine -> CE40 credits
event_dracula_init: equ 0x65d3
event_vscroll: equ 0x6848	; if CE34 set, write CE33 to VDP R23 (credits v-scroll)
player_tick: equ 0x6b06	; door + simon_action + attack + edge detector + timers
simon_action_tick: equ 0x6b40	; Simon per-frame action-state machine (0xC420)
simon_grounded: equ 0x6b59	; C420=0 walk/idle
simon_walk_left: equ 0x6c36	; face left, try -X
simon_walk_right: equ 0x6c5a	; face right, try +X
simon_add_x: equ 0x6c9b	; C426 += BC
simon_jump_tick: equ 0x6cc7	; C420=1 jump; C421 picks direction
simon_jump_arc: equ 0x6cee	; step C428 through jump_y_delta
simon_crouch: equ 0x6db0	; C420=2; on-pad + UP new-press -> portal wind-up
simon_stairs: equ 0x6de4	; C420=3
simon_fall: equ 0x6f44	; C420=4
simon_hurt: equ 0x6f8c	; C420=5
simon_dying: equ 0x709a	; C420=6
simon_portal_wait: equ 0x7102	; C420=7: wait C42D after crouch+UP on pad, then C41B=0xFF
simon_attack_tick: equ 0x7114	; try/start whip + tick + emit SAT
whip_tick: equ 0x71e7	; dispatch 0xC422 whip phase
whip_slots_clear: equ 0x751a	; zero 0xC450 whip slots + hide SAT
simon_mirror_frames: equ 0x7666	; facing-left: C42E/C42F += 0x0A/0x0F
tile_layout_draw: equ 0x7b39	; blit title_layout stream (FF=end, FE=next row)
holy_water_use: equ 0x7154	; C701 bit3: jump+LEFT/RIGHT, 5 hearts, one vial (C461)
holy_water_throw_left: equ 0x719B
holy_water_throw_right: equ 0x71A8
holy_water_throw: equ 0x71B1	; C461=5, spend 5 hearts
holy_water_tick: equ 0x73AB	; C460 type 5: spawn, arc (l7084h), pool
holy_water_arc: equ 0x73E5
holy_water_pool: equ 0x7420	; 24 frames on floor, SAT colour 8
projectile_alloc: equ 0x71C5	; free C450/C460 slot; knife may take two
projectile_arm: equ 0x728D	; whip phase 4: C436 -> slot type
projectile_tick: equ 0x72B9	; both slots: motion + integrate + clip + SAT
knife_tick: equ 0x743D		; C416=2 / bonus 0x1B; straight ±5
axe_tick: equ 0x747A		; C416=3 / bonus 0x1C; boomerang ±3
cross_tick: equ 0x72E5		; C416=4 / bonus 0x1D; boomerang ±5, SAT 0x0F/0x0E
boomerang_throw: equ 0x730E
boomerang_out: equ 0x7344
boomerang_back: equ 0x737A
boomerang_catch: equ 0x73A4	; overlap Simon -> despawn, keep C416
projectile_integrate: equ 0x74C2
projectile_clip: equ 0x74D5	; offscreen; cross/axe X-wrap -> lose_weapon
projectile_clear: equ 0x74F0
projectile_clear_hl: equ 0x74F3
l7e60h: equ 0x7E60		; HP-bar dmg leather/knife (types 0x11..0x17)
l7e67h: equ 0x7E67		; HP-bar dmg chain/axe/cross
tile_is_solid: equ 0x7c65	; carry=solid iff (tile-1) < row_solid_thresh[0xD000]
row_solid_thresh: equ 0x7c7f	; per-world-row solidity threshold byte table
map_cell_at: equ 0x7d36	; A = room tile id under pixel (D=X,E=Y) from the 0xD100 map
