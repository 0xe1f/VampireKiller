; MSX / MSX2 BIOS entry points + named Vampire Killer routines for z80dasm.
; Used by tools/regen-seg.sh when regenerating a segment disassembly so BIOS
; calls read as names (e.g. `call ENASLT`) instead of raw addresses.

; ---- MSX main-ROM BIOS jump table ----------------------------------------
CHKRAM: equ 0x0000
SYNCHR: equ 0x0008
RDSLT: equ 0x000c
CHRGTR: equ 0x0010
WRSLT: equ 0x0014
OUTDO: equ 0x0018
CALSLT: equ 0x001c
DCOMPR: equ 0x0020
ENASLT: equ 0x0024
GETYPR: equ 0x0028
CALLF: equ 0x0030
KEYINT: equ 0x0038
INITIO: equ 0x003b
INIFNK: equ 0x003e
DISSCR: equ 0x0041
ENASCR: equ 0x0044
WRTVDP: equ 0x0047
RDVRM: equ 0x004a
WRTVRM: equ 0x004d
SETRD: equ 0x0050
SETWRT: equ 0x0053
FILVRM: equ 0x0056
LDIRMV: equ 0x0059
LDIRVM: equ 0x005c
CHGMOD: equ 0x005f
CHGCLR: equ 0x0062
NMI: equ 0x0066
CLRSPR: equ 0x0069
INITXT: equ 0x006c
INIT32: equ 0x006f
INIGRP: equ 0x0072
INIMLT: equ 0x0075
SETTXT: equ 0x0078
SETT32: equ 0x007b
SETGRP: equ 0x007e
SETMLT: equ 0x0081
CALPAT: equ 0x0084
CALATR: equ 0x0087
GSPSIZ: equ 0x008a
GRPPRT: equ 0x008d
GICINI: equ 0x0090
WRTPSG: equ 0x0093
RDPSG: equ 0x0096
STRTMS: equ 0x0099
CHSNS: equ 0x009c
CHGET: equ 0x009f
CHPUT: equ 0x00a2
LPTOUT: equ 0x00a5
LPTSTT: equ 0x00a8
CNVCHR: equ 0x00ab
PINLIN: equ 0x00ae
INLIN: equ 0x00b1
QINLIN: equ 0x00b4
BREAKX: equ 0x00b7
ISCNTC: equ 0x00ba
CKCNTC: equ 0x00bd
BEEP: equ 0x00c0
CLS: equ 0x00c3
POSIT: equ 0x00c6
FNKSB: equ 0x00c9
ERAFNK: equ 0x00cc
DSPFNK: equ 0x00cf
TOTEXT: equ 0x00d2
GTSTCK: equ 0x00d5
GTTRIG: equ 0x00d8
GTPAD: equ 0x00db
GTPDL: equ 0x00de
TAPION: equ 0x00e1
TAPIN: equ 0x00e4
TAPIOF: equ 0x00e7
TAPOON: equ 0x00ea
TAPOUT: equ 0x00ed
TAPOOF: equ 0x00f0
STMOTR: equ 0x00f3
GICINI2: equ 0x00f6
RIGHTC: equ 0x00fc
LEFTC: equ 0x00ff
UPC: equ 0x0102
TUPC: equ 0x0105
DOWNC: equ 0x0108
TDOWNC: equ 0x010b
SCALXY: equ 0x010e
MAPXYC: equ 0x0111
FETCHC: equ 0x0114
STOREC: equ 0x0117
SETATR: equ 0x011a
READC: equ 0x011d
SETC: equ 0x0120
NSETCX: equ 0x0123
GTASPC: equ 0x0126
PNTINI: equ 0x0129
SCANR: equ 0x012c
SCANL: equ 0x012f
CHGCAP: equ 0x0132
CHGSND: equ 0x0135
RSLREG: equ 0x0138
WSLREG: equ 0x013b
RDVDP: equ 0x013e
SNSMAT: equ 0x0141
PHYDIO: equ 0x0144
FORMAT: equ 0x0147
ISFLIO: equ 0x014a
OUTDLP: equ 0x014d
GETVCP: equ 0x0150
GETVC2: equ 0x0153
KILBUF: equ 0x0156
CALBAS: equ 0x0159
; ---- MSX2 extended BIOS ----
SUBROM: equ 0x015c
EXTROM: equ 0x015f
CHKSLZ: equ 0x0162
CHKNEW: equ 0x0165
EOL: equ 0x0168
BIGFIL: equ 0x016b
NSETRD: equ 0x016e
NSTWRT: equ 0x0171
NRDVRM: equ 0x0174
NWRVRM: equ 0x0177

; ---- Vampire Killer resident routines (segment 0) ------------------------
int_handler: equ 0x4028	; timer-interrupt (H.TIMI) service routine
ADD_HL_A: equ 0x4061	; HL += A (unsigned)
ADD_DE_A: equ 0x4066	; DE += A (unsigned)
DISPATCH_A: equ 0x406b	; jump via inline word table indexed by A
init: equ 0x4075	; cartridge entry point
reset_run_state: equ 0x44cd	; wipe run work RAM (0xC405..0xDFFF) + seed defaults
draw_hearts_hud: equ 0x456d	; draw HEART counter (0xC417, BCD) to HUD
add_hearts: equ 0x459b	; add B hearts to 0xC417 (BCD, clamp 99); B=1 small, B=5 large
spend_hearts: equ 0x45a7	; subtract B hearts from 0xC417 (BCD, floor 0)
draw_lives_hud: equ 0x4575	; draw LIVES counter (0xC410, BCD) to HUD
draw_health_bar: equ 0x45d8	; draw HEALTH bar from 0xC415
draw_enemy_meter: equ 0x45ec	; draw ENEMY/BOSS energy meter from 0xC418
restore_health: equ 0x460c	; 0xC415 += B, clamp to 0x20
damage_health: equ 0x4632	; 0xC415 -= B, floor 0
door_blit_tiles: equ 0x5403	; paint 6 stacked 8x8 door tiles at (C5AD=Y, C5AE=X); C5AC:=1
load_simon_sprites: equ 0x56e8	; refresh Simon's 2 sprite cells (legs 0xA281/C42E, torso+whip 0xA2D1/C42F)
add_score: equ 0x44f5	; add C:D:E (BCD hi:mid:lo) to the 3-byte score at 0xC405-0xC407
damage_enemy: equ 0x4643	; 0xC418 enemy/boss energy -= B (floored at 0)
hurt_simon_contact: equ 0x8173	; Simon -= 2*l81d5h[type].odd on enemy contact (shield halves)
hurt_simon_projectile: equ 0x85ad	; Simon -= 8/16 from a 0xC580 hazard slot, sets hurt state
weapon_hit_damage: equ 0x7e33	; whip/sub-weapon damage to enemy 0xC418 (per weapon+type table)
advance_stage: equ 0x434e	; next stage: 0xD000++ (stage), 0xD001=0 (room), bump 0xC410/11, transition 4
room_map_build: equ 0x4fb6	; expand a room's 8x6 metatiles (4x4 tiles ea) into the 0xD100 tile map
read_buttons: equ 0x4bc2	; joystick|kbd row 8 -> A; play latches C007 held / C006 new-press
input_edge: equ 0x4bbb	; A=sample, (HL)=held, (HL-1)=rising-edge bits
read_fkeys: equ 0x4bfb	; sample kbd row 6 -> bit0=F1,bit1=F2,bit2=F3 (edge-detected into 0xC00B)
play_sound: equ 0x50a6	; A=id: 0=stop, 1-7F sfx, 80-FA music, FB-FF special
room_spawner: equ 0x5ebf	; per-frame enemy spawner; per-room bitmask (seg14 0x85a6[stage]) dispatches generators; bails while 0xC440 != 0
zombie_generator: equ 0x9ced	; room_spawner bit0: rate-gated zombie (actor type 01) spawner
hunchback_generator: equ 0x9d52	; room_spawner bit1: hunchback type 02 (1 HP)
hunchback_generator_3: equ 0x9d59	; room_spawner bit2: hunchback type 03 (2 HP, same AI)
bat_generator: equ 0x9d9e	; room_spawner bit3: bat type 04
ghost_generator: equ 0x9dca	; room_spawner bit4: ghost type 07
medusa_head_generator: equ 0x9ddc	; room_spawner bit5: medusa head type 08
skull_cannon_generator: equ 0x9dee	; room_spawner bit6: roc type 0x0F (drops 0x23)
spawn_actor: equ 0x5f24	; alloc a free actor slot (7 @ 0xC800, stride 0x80) + init
spawn_actor_init: equ 0x5f7e	; init tail of spawn_actor

; ---- Vampire Killer banked routines (segment 1 @ 0x6000) -----------------
konami_logo_draw: equ 0x6209	; draw Konami logo + seed the top-to-bottom wipe
konami_logo_step: equ 0x6253	; reveal one more row of the logo (poll 0xC422)
lookup_word_tbl: equ 0x6549	; DE = ((word*)DE)[A]  (generic word-table lookup)
simon_action_tick: equ 0x6b40	; Simon per-frame action-state machine (0xC420)
simon_grounded: equ 0x6b59	; C420=0 walk/idle
simon_walk_left: equ 0x6c36	; face left, try -X
simon_walk_right: equ 0x6c5a	; face right, try +X
simon_add_x: equ 0x6c9b	; C426 += BC
simon_jump_tick: equ 0x6cc7	; C420=1 jump; C421 picks direction
simon_jump_arc: equ 0x6cee	; step C428 through jump_y_delta
simon_crouch: equ 0x6db0	; C420=2; on-pad + UP new-press -> portal wind-up
simon_stairs: equ 0x6de4	; C420=3
simon_fall: equ 0x6f44	; C420=4
simon_hurt: equ 0x6f8c	; C420=5
simon_dying: equ 0x709a	; C420=6
simon_portal_wait: equ 0x7102	; C420=7: wait C42D after crouch+UP on pad, then C41B=0xFF
simon_attack_tick: equ 0x7114	; try/start whip + tick + emit SAT
whip_tick: equ 0x71e7	; dispatch 0xC422 whip phase
whip_slots_clear: equ 0x751a	; zero 0xC450 whip slots + hide SAT
simon_mirror_frames: equ 0x7666	; facing-left: C42E/C42F += 0x0A/0x0F
tile_layout_draw: equ 0x7b39	; blit title_layout stream (FF=end, FE=next row)
holy_water_use: equ 0x7154	; C701 bit3: jump+LEFT/RIGHT, 5 hearts, one vial (C461)
holy_water_throw_left: equ 0x719B
holy_water_throw_right: equ 0x71A8
holy_water_throw: equ 0x71B1	; C461=5, spend 5 hearts
holy_water_tick: equ 0x73AB	; C460 type 5: spawn, arc (l7084h), pool
holy_water_arc: equ 0x73E5
holy_water_pool: equ 0x7420	; 24 frames on floor, SAT colour 8
projectile_alloc: equ 0x71C5	; free C450/C460 slot; knife may take two
projectile_arm: equ 0x728D	; whip phase 4: C436 -> slot type
projectile_tick: equ 0x72B9	; both slots: motion + integrate + clip + SAT
knife_tick: equ 0x743D		; C416=2 / bonus 0x1B; straight ±5
axe_tick: equ 0x747A		; C416=3 / bonus 0x1C; boomerang ±3
cross_tick: equ 0x72E5		; C416=4 / bonus 0x1D; boomerang ±5, SAT 0x0F/0x0E
boomerang_throw: equ 0x730E
boomerang_out: equ 0x7344
boomerang_back: equ 0x737A
boomerang_catch: equ 0x73A4	; overlap Simon -> despawn, keep C416
projectile_integrate: equ 0x74C2
projectile_clip: equ 0x74D5	; offscreen; cross/axe X-wrap -> lose_weapon
projectile_clear: equ 0x74F0
projectile_clear_hl: equ 0x74F3
l7e60h: equ 0x7E60		; HP-bar dmg leather/knife (types 0x11..0x17)
l7e67h: equ 0x7E67		; HP-bar dmg chain/axe/cross
tile_is_solid: equ 0x7c65	; carry=solid iff (tile-1) < row_solid_thresh[0xD000]
row_solid_thresh: equ 0x7c7f	; per-world-row solidity threshold byte table
map_cell_at: equ 0x7d36	; A = room tile id under pixel (D=X,E=Y) from the 0xD100 map
door_interact: equ 0x771f	; white-key door tick: proximity vs C5AD/Y,C5AE/X; spend 0xC701 bit0
set_stage_boundary: equ 0x7807	; blocked horizontal edge walk-off -> set 0xC408 (advance_stage)

; ---- Vampire Killer banked routines (segment 2 @ 0x8000) -----------------
door_proximity: equ 0x8587	; carry if Simon (B=Y,C=X) overlaps door at C5AD=Y / C5AE=X
door_anim_tick: equ 0x914e	; 0xC5AC door state: 0xFF -> door_blit_tiles; 3 = opening frames
door_begin_open: equ 0x9175	; if C5AC==1, set 0xFF and jp door_anim_tick (start opening)
collect_bonus: equ 0x8d33	; apply picked-up bonus id A (latch 0xC419, table @ 0x8D45)
collect_bonus_tbl: equ 0x8D45	; word[id-1] handlers; id>=0x1A weapon except 0x1E holy water
bonus_red_shield: equ 0x8D9F	; id 3: C701 bit4, face-on contact uses table dmg
bonus_yellow_shield: equ 0x8DA8	; id 4: C701 bit5, absorb D700 projectiles
bonus_white_cross: equ 0x8DC2	; id 5: despawn on-screen actors
bonus_rosary: equ 0x8D83	; id 6: C440 no-spawn timer
bonus_small_heart: equ 0x8DB6	; id 1: +1 heart
bonus_large_heart: equ 0x8DBE	; id 2: +5 hearts
bonus_small_orb: equ 0x8DE5	; id 7: +8 HP (1/4 of 0x20 bar)
bonus_blue_gem: equ 0x8DD4	; id 8: C43A invis, sprite flash white
bonus_sapphire_ring: equ 0x8DEC	; id 9: C434, sprite flash red, touch-kills
bonus_hourglass: equ 0x8D9B	; id 10: C701 bit6; jump+DOWN spends 5 hearts
bonus_holy_water: equ 0x8D94	; bonus 0x1E: C701 bit3; jump+LEFT/RIGHT, not C416
bonus_tipped_hourglass: equ 0x8DFC	; id 11: whip id 10 once; C431 bit2 1.5x timers
bonus_boots: equ 0x8E03		; id 12: C431 bit3 faster walk
bonus_wings: equ 0x8E0A		; id 13: C431 bit4 higher jump
bonus_slime: equ 0x8E1B		; id 21: fake pickup (hatches enemy if left); collect is a stub
bonus_chest: equ 0x8E1B		; id 25: chest container (same stub; world path opens at l8c1bh)
bonus_candle: equ 0x8E1D	; id 14: C702 bit0, white outlines on C470 blocks
bonus_black_bible: equ 0x8E24	; id 16: C702 bit6, vendor price doubled
bonus_white_bible: equ 0x8E2D	; id 17: C702 bit7, vendor price halved
bonus_map: equ 0x8E3A		; id 15: C431 bit6, C701 bit7, C70F=3
bonus_white_bag: equ 0x8E49	; id 19: +5000 score
bonus_blue_bag: equ 0x8E52	; id 20: +1000 score
bonus_yellow_key: equ 0x8E57	; id 23: C701 bit1, C700=1
bonus_white_key: equ 0x8E67	; id 24: C701 bit0
bonus_staff: equ 0x8E80		; id 18: C700=3, C701 bit2; drops yellow key
bonus_potion: equ 0x8E14	; id 22: bottle, +32 HP; vendor 0x16 (not boss orb)
lose_weapon: equ 0x8E9A		; missed catch: C416=0, refresh HUD
projectile_hit_actors: equ 0x8025	; C450/C460 vs C800
proj_overlap_simon: equ 0x8247	; projectile box vs Simon (boomerang catch)
actors_rearm_hittable: equ 0x99A6	; +0E bit2 -> set bit0 on C800/D700
yellow_shield_tick: equ 0x8617	; absorb D700 projectiles while C701 bit5
hourglass_use: equ 0x7166	; jump+DOWN + 5 hearts -> C43B / D010 freeze
brazier_tick_all: equ 0x8678	; per-frame update of the 8 brazier/candle slots (0xC470)
brazier_tick: equ 0x8693	; update one brazier/candle (flame anim + hit test)
brazier_destroyed: equ 0x87c1	; brazier/candle hit: clear it + run item drop
vendor_outcome_dispatch: equ 0x92ae	; run whip-hit outcome by state 0xC70C (hearts/nothing/leave)
vendor_pick_outcome: equ 0x92c2	; advance vendor state machine (transition tbl + R-reg RNG)
vendor_transition_tbl: equ 0x9307	; 8-byte rows -> next 0xC70C state (>=7 = RNG coin-flip)
vendor_make_offer: equ 0x938e	; arm a sale: item 0xC708, price 0xC707, timer 0xC706
vendor_set_offer_item: equ 0x9406	; pick sale item -> 0xC708 and look up price row
vendor_select_price: equ 0x941f	; 0xC702 bible flags pick normal/half/double price -> 0xC707
vendor_price_tbl: equ 0x942f	; 9 x {item id, normal, half(white bible), double(black bible)}
vendor_offer_withdraw: equ 0x9503	; offer declined/expired/unaffordable: sfx 0x02, ret 0
vendor_offer_pending: equ 0x950a	; no button this frame: ret 0xFF (keep offer open)
vendor_purchase_tick: equ 0x94be	; offer loop: tick timer 0xC706, poll buy/refuse, buy item
vendor_read_buttons: equ 0x9526	; edge-detected confirm(SPACE)/refuse(SHIFT)+triggers -> A
read_kbd_matrix_bit: equ 0x9552	; read one keyboard-matrix bit (row in A) -> 0/1
minimap_driver: equ 0x955a	; F2 world-map driver: state 0xCF38 (0 play/1 build/2 shown); needs map item 0xC701 bit7 + uses 0xC70F
minimap_build: equ 0x95d7	; draw whole minimap: loop rooms 0..minimap_room_count[stage]-1
minimap_room_pos: equ 0x9681	; AUTHORITATIVE room position: stage tbl 0x969c -> per-room code -> coord tbl 0x975e -> 0xCFF2
minimap_stage_ptr: equ 0x969c	; word[stage] -> per-room minimap position-code array
minimap_coord_tbl: equ 0x975e	; word[code] -> packed minimap coord (hi=X 0x20+0x20*col, lo=Y 0x38+0x15*row)
minimap_room_count: equ 0x95fd	; byte[stage] = room count (incl. stage 18/Dracula = 10)
flame_init: equ 0x9b67	; seed a destruction-flame effect (frame 0x85, timer 0x10)
flame_tick: equ 0x9b78	; flame flicker 0x85/0x86; on expiry spawn 0x24 pickup
actor_integrate: equ 0x99c0	; add velocity (+0x07/08 Y, +0x09/0A X) to position
actor_cull_offscreen: equ 0x99ec	; free actor if pixel pos left the play area
actor_free: equ 0x99fd	; clear actor slot (+0x00/+0x0E) and any linked sub-slot

; ---- Vampire Killer banked routines (segment 13 @ 0xA000) ----------------
mtile_def_c41a: equ 0xA041	; metatile-def base when 0xC41A != 0
simon_cell0_ptr: equ 0xA281	; 40 words, index 0xC42E (legs) -> RLE streams
simon_cell1_ptr: equ 0xA2D1	; 36 words, index 0xC42F (torso/whip) -> RLE streams
intro_sky: equ 0xB895		; intro cloud/bat sprite stream (VRAM 0xFA00)
conn_lookup: equ 0xB963		; pending dir 0xC41B -> dest room 0xD001 (0xF = blocked)
conn_write_room: equ 0xB987	; ld (0xD001),a / scf / ret
conn_from_spot: equ 0xB98C	; C41B==0xFF: D001 = C5B4 (spot_tbl dest nibble)
add_hl_a_s13: equ 0xB995	; banked ADD_HL_A copy (resident 0x4000 not visible)
conn_load_permits: equ 0xB99A	; unpack nibbles -> 0xC41C-0xC41F (0xF becomes 0xFF)
conn_room_record: equ 0xB9BD	; HL = conn_ptr[D000] + 2*D001
conn_ptr: equ 0xB9D3		; word[stage 0..18] -> packed up/down/left/right records
door_load: equ 0xBB31		; door_load_coords then spot_load_coords
door_load_coords: equ 0xBB37	; if D001 == door_tbl[D000].room, write C5AD=Y,C5AE=X and arm C5AC
door_tbl: equ 0xBB61		; 19x3: (room | vert<<7), Y->C5AD, X->C5AE. Room = low nibble.
spot_load_coords: equ 0xBB9A	; scan spot_tbl; arm C5B1, Y/X at C5B2, dest nibble at C5B4
spot_tbl: equ 0xBBCD		; (stage, dest<<4|room, Y, X) 0xFF-ended; currently stage 12
spot_proximity: equ 0x85FB	; carry if Simon overlaps armed spot (C5B1/Y/X)

; ---- Vampire Killer resident paged-call wrappers (segment 0) -------------
conn_lookup_paged: equ 0x5A35	; page seg13, conn_lookup, restore
conn_load_permits_paged: equ 0x5A3E	; page seg13, conn_load_permits, restore
door_load_paged: equ 0x5A47	; page seg13, door_load, restore

; ---- Vampire Killer map-data banks (segment 11 @ 0x6000, 12 @ 0x8000) ----
mtile_rowbase: equ 0x6000	; byte[stage]=first room index (seg11; stages 0..18)
mtile_roomptr: equ 0x6013	; word[index]->48-byte 8x6 stream (156 rooms)
mtile_stream_c41a: equ 0x614B	; alternate 8x6 stream when 0xC41A != 0
mtile_streams: equ 0x617B	; 156 packed 8x6 streams (48 bytes each)
mtile_defbase: equ 0x7EBB	; word[stage]->4x4 metatile-def table (may straddle banks)
mtile_defs_s00: equ 0x7EE1	; stage 0 defs (seg11; tail in seg12)
mtile_defs_s01: equ 0x80B1	; stages 1-3 defs (seg12)
mtile_defs_s04: equ 0x84D1	; stages 4-6
mtile_defs_s07: equ 0x8791	; stages 7-9
mtile_defs_s10: equ 0x8D21	; stages 10-12
mtile_defs_s13: equ 0x9121	; stages 13-15
mtile_defs_s16: equ 0x9651	; stages 16-17
mtile_defs_s18: equ 0x9AC1	; stage 18 (tail in seg13 0xA000-0xA040)

; ---- Vampire Killer banked routines (segment 3 @ 0xA000) -----------------
enemy_hunchback_tick: equ 0xa2e7	; entity types 2/3 (hunchback, 1 HP / 2 HP) behaviour handler
enemy_medusa_head_tick: equ 0xa502	; entity type 8 (medusa head) behaviour handler
enemy_zombie_tick: equ 0xa93b	; entity type 1 (walking zombie) behaviour handler
enemy_dog_tick: equ 0xa863	; entity type 5 ("sitting dog") behaviour handler
enemy_ghost_tick: equ 0xb068	; entity type 7 (ghost) behaviour handler
enemy_bat_tick: equ 0xb0d1	; entity type 4 (bat) behaviour handler
enemy_skull_cannon_tick: equ 0xb19a	; entity type 15 roc (stale name; drops type 0x23)
actor_add_yvel: equ 0xa550	; Yvel += DE, clamped to [0,0x7FF] (gravity/terminal)
actor_set_yvel: equ 0xa564	; store DE -> Y velocity (+0x07/+0x08)
actor_add_xvel: equ 0xa56b	; Xvel += DE (+0x09/+0x0A)
actor_set_xvel: equ 0xa573	; store DE -> X velocity (+0x09/+0x0A)
actor_set_xvel_speedup: equ 0xa65a	; set X velocity + progress speed bias (0xD012 tier * 32)
