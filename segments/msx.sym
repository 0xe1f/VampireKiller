enemy_mummy_go: equ 0xb89a	; ix+1: idle/face/walk/spit
enemy_frankenstein_tick: equ 0xba56	; entity type 21 (Frankenstein)
enemy_frankenstein_go: equ 0xba6b	; chase / pace; arms Igor via CE07
