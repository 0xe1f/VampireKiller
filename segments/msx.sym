simon_walk_left: equ 0x6c36	; face left, try -X
simon_walk_right: equ 0x6c5a	; face right, try +X
simon_add_x: equ 0x6c9b	; C426 += BC
simon_jump_tick: equ 0x6cc7	; C420=1 jump; C421 picks direction
simon_jump_arc: equ 0x6cee	; step C428 through jump_y_delta
simon_land_sfx_arm: equ 0x6d74	; late jump: CFF0 so landing plays sfx 7
simon_crouch: equ 0x6db0	; C420=2; on-pad + UP new-press -> portal wind-up
simon_stairs: equ 0x6de4	; C420=3
simon_stair_frames_down: equ 0x6f10	; descending: C42E/C42F from C42B bit2
simon_stair_frames_up: equ 0x6f2b	; ascending: same C, legs step 1 or 2
simon_fall: equ 0x6f44	; C420=4
simon_hurt: equ 0x6f8c	; C420=5
simon_hurt_init: equ 0x6f9a	; sfx, i-frames; stairs if C42B else knock
simon_hurt_knock: equ 0x6fc3	; hurt_facing -> simon_facing; step 1 left / 2 right
