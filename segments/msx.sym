dracula_bat_xvel: equ 0x6a93	; 8 home-X speeds; index CF32&7
dracula_bat_go: equ 0x6aa3	; type 0x2C tick: robe 0x02/0xA5, head open/closed, then bat fly
hanging_bat_pose: equ 0x6b00	; trampoline to hanging_bat_flap_slow (one rra)
player_tick: equ 0x6b06	; door + simon_action + attack + edge detector + timers
timers_tick: equ 0x75c7	; dec C440 (rosary), C434 (ring), C42D (i-frames)
dec_nonzero: equ 0x75d6	; dec (hl) unless already 0
boss_flash_delay_tick: equ 0x75db	; C445 -> arm C43E=0x18 backdrop flash
gem_timer_tick: equ 0x75e9	; C43A invis; sfx 0x17 at 16 frames left
hourglass_timer_tick: equ 0x75f9	; hourglass_timer; on 0: res D010.0, play_sound 0xFC
backdrop_flash_tick: equ 0x760b	; C43E CHGCLR 0x0E/0 (white cross / boss kill)
simon_action_tick: equ 0x6b40	; Simon per-frame action-state machine (0xC420)
simon_grounded: equ 0x6b59	; C420=0 walk/idle
platform_carry_simon: equ 0x6bb6	; ride: Simon X += sign of the C598 slot's step
simon_try_stairs_up: equ 0x6be1	; grounded + UP: probe stair tiles, else fall through
