enemy_giant_bat_go: equ 0xbe77	; idle/begin/aim/swoop/spit/climb
actor_orb_tick: equ 0xb77e	; actor_orb spawn-init
actor_orb_go: equ 0xb7a8	; flash / settle / spin
actor_add_yvel: equ 0xa550	; Yvel += DE, clamped to [0,0x7FF] (gravity/terminal)
actor_set_yvel: equ 0xa564	; store DE -> Y velocity (+0x07/+0x08)
actor_add_xvel: equ 0xa56b	; Xvel += DE (+0x09/+0x0A)
actor_set_xvel: equ 0xa573	; store DE -> X velocity (+0x09/+0x0A)
actor_set_xvel_speedup: equ 0xa65a	; set X velocity + progress speed bias (0xD012 tier * 32)

; ---- Vampire Killer data (segment 14 @ 0x8000) ----------------------------
scenery_list_ptr: equ 0x8000	; word[hub] -> packed scenery streams
scenery_list_s00: equ 0x800c	; stage 0 courtyard scenery stream
spawn_bitmask_ptr: equ 0x85a6	; word[stage] -> per-room spawn bitmask
object_list_ptr: equ 0x8668	; word[hub] -> packed object streams
credits_font: equ 0x8824		; 14 x 8x8 1bpp ending-credits glyphs (0-9 . ' : ,)
credits_font_az: equ 0x8894		; 26 x 8x8 1bpp glyphs A-Z
sound_tick: equ 0x8964		; IRQ PSG tick (int_handler, segs 14+15 paged)
sound_ch_dispatch: equ 0x89bc	; call sound_ch_go then the C016 (sfx) slot
sound_ch_go: equ 0x89c6		; C094=A channel, C095=B slot, jp (HL)
sound_idle: equ 0x89ce		; silent-channel tick (all C010..C016 on stop)
sound_fd_tick: equ 0x89f2	; C098 bit0: jp (C01A)  (play_sound 0xFD)
sound_fb_tick: equ 0x89f6	; C098 bit1: run C018 as slot 4
sound_psg_period: equ 0x89ff	; write 12-bit period DE to PSG (fine=C094*2)
sound_psg_vol: equ 0x8a0b	; write E to PSG amp (reg 8+C094)
sound_mix_mute: equ 0x8a13	; mixer: mute this channel
sound_mix_both: equ 0x8a1a	; mixer: tone + noise
sound_mix_noise: equ 0x8a21	; mixer: noise only
sound_mix_tone: equ 0x8a28	; mixer: tone only
sound_mix_apply: equ 0x8a2c	; apply AND/OR pair from (HL)[C094] to C097 + PSG 7
sound_mix_tone_tbl: equ 0x8a45	; 3 x (AND,OR) enable tone, disable noise
sound_mix_noise_tbl: equ 0x8a4b
sound_mix_both_tbl: equ 0x8a51
sound_mix_mute_tbl: equ 0x8a57
sound_ch_fd: equ 0x8a5d		; play_sound 0xFD channel (IX=0xC080)
sound_ch_a: equ 0x8a64		; music channel A (IX=0xC01C)
sound_ch_b: equ 0x8a6b		; music channel B (IX=0xC030)
sound_ch_c: equ 0x8a72		; music channel C (IX=0xC044)
sound_ch_tick: equ 0x8a76	; common music-channel bytecode tick
sound_fetch: equ 0x8ad0		; next music bytecode at (HL)
sound_note_tbl: equ 0x8b81	; 12 PSG periods, one octave (hi nibble of note)
sound_rest: equ 0x8b99		; 0xC0..CF rest: duration only, period 0
sound_cmd: equ 0x8bb4		; music command (byte >= 0xD0)
sound_ch_fb: equ 0x8c95		; play_sound 0xFB channel (IX=0xC06C)
sound_sfx: equ 0x8c9c		; sfx channel tick (IX=0xC058)
sound_sfx_go: equ 0x8ca0	; shared FB/sfx: fetch, idle when done
sound_sfx_fetch: equ 0x8ca7	; sfx bytecode; NC=hold, CY=finished
sound_sfx_hold: equ 0x8d8b	; or a / ret (NC, still playing)
sfx_ptr: equ 0x8d8d		; scf/ret (CY, done); play_sound indexes id*2 from here
sfx_tbl: equ 0x8d8f		; word[id 1..0x1D] -> sfx streams
music_ptr: equ 0x8dc9		; 6-byte records, 3 channel ptrs, id 0x80..0x8F
snd_fd_seq: equ 0x9463		; play_sound 0xFD overlay stream
snd_fb_seq: equ 0x948b		; play_sound 0xFB overlay stream
