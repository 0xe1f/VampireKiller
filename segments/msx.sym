; MSX / MSX2 BIOS entry points + named Vampire Killer routines for z80dasm.
; Used by tools/workbench/msx/regen-bank.sh when regenerating a bank so BIOS
; calls read as names (e.g. `call ENASLT`) instead of raw addresses.

; ---- MSX main-ROM BIOS jump table ----------------------------------------
CHKRAM: equ 0x0000
SYNCHR: equ 0x0008
RDSLT: equ 0x000c
CHRGTR: equ 0x0010
WRSLT: equ 0x0014
OUTDO: equ 0x0018
CALSLT: equ 0x001c
DCOMPR: equ 0x0020
ENASLT: equ 0x0024
GETYPR: equ 0x0028
CALLF: equ 0x0030
KEYINT: equ 0x0038
INITIO: equ 0x003b
INIFNK: equ 0x003e
DISSCR: equ 0x0041
ENASCR: equ 0x0044
WRTVDP: equ 0x0047
RDVRM: equ 0x004a
WRTVRM: equ 0x004d
SETRD: equ 0x0050
SETWRT: equ 0x0053
FILVRM: equ 0x0056
LDIRMV: equ 0x0059
LDIRVM: equ 0x005c
CHGMOD: equ 0x005f
CHGCLR: equ 0x0062
NMI: equ 0x0066
CLRSPR: equ 0x0069
INITXT: equ 0x006c
INIT32: equ 0x006f
INIGRP: equ 0x0072
INIMLT: equ 0x0075
SETTXT: equ 0x0078
SETT32: equ 0x007b
SETGRP: equ 0x007e
SETMLT: equ 0x0081
CALPAT: equ 0x0084
CALATR: equ 0x0087
GSPSIZ: equ 0x008a
GRPPRT: equ 0x008d
GICINI: equ 0x0090
WRTPSG: equ 0x0093
RDPSG: equ 0x0096
STRTMS: equ 0x0099
CHSNS: equ 0x009c
CHGET: equ 0x009f
CHPUT: equ 0x00a2
LPTOUT: equ 0x00a5
LPTSTT: equ 0x00a8
CNVCHR: equ 0x00ab
PINLIN: equ 0x00ae
INLIN: equ 0x00b1
QINLIN: equ 0x00b4
BREAKX: equ 0x00b7
ISCNTC: equ 0x00ba
CKCNTC: equ 0x00bd
BEEP: equ 0x00c0
CLS: equ 0x00c3
POSIT: equ 0x00c6
FNKSB: equ 0x00c9
ERAFNK: equ 0x00cc
DSPFNK: equ 0x00cf
TOTEXT: equ 0x00d2
GTSTCK: equ 0x00d5
GTTRIG: equ 0x00d8
GTPAD: equ 0x00db
GTPDL: equ 0x00de
TAPION: equ 0x00e1
TAPIN: equ 0x00e4
TAPIOF: equ 0x00e7
TAPOON: equ 0x00ea
TAPOUT: equ 0x00ed
TAPOOF: equ 0x00f0
STMOTR: equ 0x00f3
GICINI2: equ 0x00f6
RIGHTC: equ 0x00fc
LEFTC: equ 0x00ff
UPC: equ 0x0102
TUPC: equ 0x0105
DOWNC: equ 0x0108
TDOWNC: equ 0x010b
SCALXY: equ 0x010e
MAPXYC: equ 0x0111
FETCHC: equ 0x0114
STOREC: equ 0x0117
SETATR: equ 0x011a
READC: equ 0x011d
SETC: equ 0x0120
NSETCX: equ 0x0123
GTASPC: equ 0x0126
PNTINI: equ 0x0129
SCANR: equ 0x012c
SCANL: equ 0x012f
CHGCAP: equ 0x0132
CHGSND: equ 0x0135
RSLREG: equ 0x0138
WSLREG: equ 0x013b
RDVDP: equ 0x013e
SNSMAT: equ 0x0141
PHYDIO: equ 0x0144
FORMAT: equ 0x0147
ISFLIO: equ 0x014a
OUTDLP: equ 0x014d
GETVCP: equ 0x0150
GETVC2: equ 0x0153
KILBUF: equ 0x0156
CALBAS: equ 0x0159
; ---- MSX2 extended BIOS ----
SUBROM: equ 0x015c
EXTROM: equ 0x015f
CHKSLZ: equ 0x0162
CHKNEW: equ 0x0165
EOL: equ 0x0168
BIGFIL: equ 0x016b
NSETRD: equ 0x016e
NSTWRT: equ 0x0171
NRDVRM: equ 0x0174
NWRVRM: equ 0x0177

; ---- Vampire Killer resident routines (segment 0) ------------------------
int_handler: equ 0x4028	; timer-interrupt (H.TIMI) service routine
int_tick: equ 0x4030	; per-frame body after GM pause check (page 14/15, sound_tick, main_tick)
int_tick_done: equ 0x405f	; ei;ret — skip the rest of this interrupt
gm_paused: equ 0x40f1	; STOP-pause: ';' steps one tick, STOP again resumes
gm_pause_step: equ 0x40fc	; restore PSG and run one int_tick while paused
gm_pause_hold: equ 0x4102	; keep PSG muted and freeze this interrupt
main_state_set_0: equ 0x41b5	; C000=0 then main_state_set
main_state_set: equ 0x41b6	; C000=A, C004=0x20, C001=0
main_timer_set: equ 0x41c9	; C004=A then main_phase_next
main_phase_next: equ 0x41cc	; C001++
main_state_inc_20: equ 0x4249	; C004=0x20 then main_state_inc
main_state_inc: equ 0x424b	; C004=A, C000++, C001=0
main_phase_reset: equ 0x4252	; C001=0
pause_enter: equ 0x428c	; draw pause panel, goto main state 0x0B
ADD_HL_A: equ 0x4061	; HL += A (unsigned)
ADD_HL_A_SIGNED: equ 0xa82a	; HL += signed A (seg3; +ve is ADD_HL_A)
ADD_DE_A: equ 0x4066	; DE += A (unsigned)
DISPATCH_A: equ 0x406b	; jump via inline word table indexed by A
init: equ 0x4075	; cartridge entry point
reset_run_state: equ 0x44cd	; wipe run work RAM (0xC405..0xDFFF) + seed defaults
run_seed_tbl: equ 0x44f0	; new-game C410..C412: lives=3, STAGE=0, C412=1
add_score_c0: equ 0x44f3	; ld c,0 then add_score (jp here with DE=amount)
draw_hearts_hud: equ 0x456d	; draw HEART counter (0xC417, BCD) to HUD
hud_draw_digit: equ 0x458f	; low nibble of A -> HUD numeral tile 0x20+ at DE
add_hearts: equ 0x459b	; add B hearts to 0xC417 (BCD, clamp 99); B=1 small, B=5 large
spend_hearts: equ 0x45a7	; subtract B hearts from 0xC417 (BCD, floor 0)
draw_lives_hud: equ 0x4575	; draw LIVES counter (0xC410, BCD) to HUD
draw_health_bar: equ 0x45d8	; draw HEALTH bar from 0xC415
draw_enemy_meter: equ 0x45ec	; draw ENEMY/BOSS energy meter from 0xC418
restore_health: equ 0x460c	; 0xC415 += B, clamp to 0x20
damage_health: equ 0x4632	; 0xC415 -= B, floor 0
door_blit_tiles: equ 0x5403	; paint 6 stacked 8x8 door tiles at (C5AD=Y, C5AE=X); C5AC:=1
door_tile_ptr: equ 0x5428	; 6 word pointers, top to bottom, into door_tiles
door_tile_joint: equ 0x5434	; 8x8 4bpp door bar segment, joint on rows 2-6
door_tile_shaft: equ 0x5454	; 8x8 4bpp door bar segment, plain shaft
door_tile_joint_end: equ 0x5474	; 8x8 4bpp door bar segment, joint up one, last row blank
load_weapon_sprites: equ 0x559a	; C416 2/3/4: RLE projectile patterns from seg10 to 0xF8C0
weapon_sprite_ptr: equ 0x55de	; word[C416-2] knife/axe/cross streams
load_vdoor_sprites: equ 0x55f3	; vertical-door extra patterns (C5AC==5) + door SAT
load_stage_tileset: equ 0x5653	; blit tileset_ptr[D000] (0xBF 8x8 4bpp) to VRAM 0x8004
load_intro_tileset: equ 0x5677	; blit intro_tiles (seg9 0x8000) via tileset_blit
load_intro_sprites: equ 0x567f	; intro_simon_0..7 + intro_sky into sprite VRAM
load_simon_sprites: equ 0x56e8	; refresh Simon's 2 sprite cells (legs 0xA281/C42E, torso+whip 0xA2D1/C42F)
stage_palette_load: equ 0x5714	; HUD-fixed + stage_palette_ptr[stage]
intro_palette_load: equ 0x573a	; HUD-fixed then intro_palette (0xBFA1)
tileset_ptr: equ 0x5749	; word[stage 0..18] -> uncompressed tileset in seg4-8
load_shared_sprites: equ 0x576f	; fireball/flame gfx_rle_a185 @ FF00 + gfx_rle_a147 @ F9C0
; tileset_s00 @ 0x6000 (seg4) omitted: collides with mtile_rowbase (seg11)
; tileset_s13 @ 0x8000 (seg7) omitted: collides with scenery_list_ptr (seg14)
tileset_s01: equ 0x7220	; stages 1-3 (seg4, spills into seg5)
tileset_s07: equ 0x8493	; stages 7-9 (seg5)
tileset_s04: equ 0x95b3	; stages 4-6 (seg5, spills into seg6)
tileset_s10: equ 0x9e73	; stages 10-12 (seg5, spills into seg6)
actor_shape_ptr: equ 0xb473	; word[shape id 0..0xA7] -> SAT stream (seg6)
tileset_s16: equ 0x9640	; stages 16-17 (seg7, spills into seg8)
tileset_s18: equ 0xa4c0	; stage 18 (seg8)
hud_weapon_key_tiles: equ 0xb9c8	; HUD 16x16 bonus 0x17-0x1E; candle frames follow (seg6)
hud_white_key: equ 0xba48	; bonus 0x18
hud_chest: equ 0xbac8		; bonus 0x19
hud_chain_whip: equ 0xbb48	; bonus 0x1A
hud_knife: equ 0xbbc8		; bonus 0x1B
hud_axe: equ 0xbc48		; bonus 0x1C
hud_cross: equ 0xbcc8		; bonus 0x1D
hud_holy_water: equ 0xbd48	; bonus 0x1E
candle_0: equ 0xbdc8		; playfield candle flame 0 (candle_blit A=0, VRAM Y=0x70)
candle_1: equ 0xbe48		; playfield candle flame 1
candle_2: equ 0xbec8		; playfield candle flame 2
candle_3: equ 0xbf48		; playfield candle flame 3
title_logo_jp_tiles: equ 0xaea0	; title kana glyphs (seg8)
title_logo_en_tiles: equ 0xb260	; title CASTLEVANIA glyphs (seg8)
title_castle_tiles: equ 0xac80	; 0x11 shared castle emblem glyphs (seg8)
hud_font: equ 0xbd80		; 48 x 8x8 1bpp HUD/title glyphs ('0'-'_') (seg8)
hud_font_solid: equ 0xbed8	; all-1s glyph; hud_font_load blits ink 0 to (0,0) for space
hud_tile_bf00: equ 0xbf00	; 8x8 4bpp follow-on (hud_font_load -> VRAM 0xA440)
dracula_portrait_load: equ 0x5887	; event-6: seg15 frame+face tiles into page-1 atlas (s18r9)
dracula_portrait_palette: equ 0x59f3	; event-6: HUD-fixed then 0xBF6F pink/flesh (replaces s18 purple)
dracula_portrait_parts_load: equ 0x5992	; 8 x 16x16 eyes/mouth to page-1 Y=0xA0
dracula_portrait_parts_mirror: equ 0x599d	; H-mirror mouth tiles 4-7 to X=128
dracula_body_load: equ 0x57e6	; event-6: unpack figure 32x32 cloak/chest to page-1 Y=0x80
dracula_body_vram: equ 0x5816	; 32x32 from 0xE800 to VRAM DE
dracula_body_unpack: equ 0x5834	; packed 4bpp rows (N zeros + 12-N + 4 zeros) -> 0xE800
dracula_body_hflip: equ 0x5858	; H-mirror the 32x32 at 0xE800
nibble_hflip: equ 0x5873	; swap 4bpp nibbles between (hl) and (de), B bytes, de--
dracula_portrait_blit: equ 0x589c	; frame + 108 face 8x8s into page-1 atlas
dracula_portrait_hflip: equ 0x58d3	; H-mirror face/frame into dest atlas ids
dracula_hflip_run: equ 0x58f1	; B tiles: tile8_hflip then atlas_advance_x4
dracula_tile8_hflip_blit: equ 0x5904	; copy 8x8 to E800, hflip, blit
tile8_hflip: equ 0x5919	; H-flip 8x8 4bpp at 0xE800 (nibble_hflip)
dracula_portrait_vflip: equ 0x5931	; V-mirror frame tiles (top -> bottom)
dracula_vflip_run: equ 0x594f	; B tiles: tile8_vflip_blit then atlas_advance_x4
atlas_advance_x4: equ 0x5962	; DE += 4 in the 8x8 atlas, wrap row
tile8_vflip_blit: equ 0x5970	; V-flip 8x8 from VRAM HL into dest DE
tile16_hflip_blit: equ 0x59c3	; copy 16x16 to E800, hflip, blit
tile16_hflip: equ 0x59d8	; H-flip 16x16 4bpp at 0xE800
main_tick: equ 0x414d	; top-level per-frame state machine (from int_handler)
vram_write: equ 0x467c	; CPU RAM -> VRAM via OTIR (HL dest, DE src after ex)
vram_read: equ 0x4661	; VRAM HL -> CPU DE via INIR (pages via vram_otir_count)
vram_otir_count: equ 0x4674	; A = pages, B = remainder from BC after ex de,hl
vram_fill: equ 0x468f	; fill VRAM HL with A, BC bytes (B pages, C rem)
vram_poke: equ 0x46a7	; write A to VRAM HL (one byte)
vdp_set_write: equ 0x46b6	; set VDP VRAM write pointer from HL (R14 + bit6)
vdp_set_read: equ 0x46d5	; set VDP VRAM read pointer from HL (R14, no bit6)
rle_dec_addr: equ 0x46f2	; RLE unpack; dest word taken from the stream
rle_dec: equ 0x46f8	; RLE unpack DE -> VRAM HL (0 / 80-addr / run / literal)
gfx_script_run: equ 0x471b	; gfx-script walk: 0=RLE, 1=gfx_script_convert, 2+=copy, FF=end
gfx_script_convert: equ 0x4745	; cmd 1: 1bpp sprite convert via 0xE800 then vram_write
gfx_1bpp_expand: equ 0x4786	; expand A planes from 0xE800 -> 0xEC10 (gfx_script_convert)
gfx_1bpp_row: equ 0x47a4	; 16 source bytes -> 16 dest (highest-set-bit encode)
video_clear_page: equ 0x47b8	; sat hide, screen off, HMMV 256x256 page 0, screen on
video_reset: equ 0x47c0	; sat hide, screen off, HMMV 256x212 page 0, screen on
vdp_screen_off: equ 0x47db	; R1 display off, then vdp_sprites_off
vdp_fill_origin: equ 0x47e8	; HMMV from (0,0) page 0 size BC, R23=0
sat_vram_hide: equ 0x47f7	; fill VRAM SAT 0xF600 with Y=0xE0, then sprites_hide
vdp_screen_on: equ 0x47ce	; R1 display on, then vdp_sprites_on
vdp_sprites_off: equ 0x4805	; VDP R8 SPD set (sprites disabled)
vdp_sprites_on: equ 0x4810	; VDP R8 SPD clear
gfx_script_rle: equ 0x4735	; cmd 0: src word, VRAM dest word -> rle_dec
gfx_script_copy: equ 0x4772	; cmd 2+: 6-byte VRAM blit (vram_write)
palette_set: equ 0x481b	; write one MSX2 palette entry A=index, D=0rrr0bbb, E=g
palette_apply: equ 0x4845	; apply (index,rb,g)+ table at HL, 0xFF-terminated
video_init: equ 0x4b60	; SCREEN 5 + clear VRAM pages 0/1
page_play_banks: equ 0x533d	; restore play banks: seg1/2/3 at 6000/8000/A000
page_sound_banks: equ 0x5357	; page seg14/15 at 8000/A000
page_map_banks: equ 0x5369	; page seg11/12/13 (map + Simon RLE)
page_title_banks: equ 0x5381	; page seg9/10 at 8000/A000
page_tileset_late: equ 0x5393	; page seg7/8 (stage >= 13 tilesets)
page_tileset_banks: equ 0x53a5	; page seg4/5/6 (early-stage tilesets)
palette_hud_load: equ 0x572e	; load the 8 fixed HUD/sprite colours from hud_fixed_palette
play_tick: equ 0x5c2c	; in-stage play loop: events, actors, SAT, pause, credits
room_gfx_load: equ 0x5787	; 9AB0[D000-1][D001]: gfx_script_run then palette_apply
vdp_hmmm: equ 0x494d	; V9938 HMMM: HL=SX,SY DE=DX,DY BC=NX,NY; A=pages
vdp_lmmm: equ 0x49e2	; V9938 LMMM (colour-0 skip); A packed pages+logic
vdp_cmd_wait: equ 0x4853	; spin until S#2 bit0 (CE) clears
vdp_status_read: equ 0x485c	; read status register A via R15, then restore R15=0
vdp_line_h: equ 0x487c	; LINE: H=X L=Y B=length C=colour (MAJ 0, along X)
vdp_line_v: equ 0x48af	; LINE with MAJ 1 (along Y); same H/L/B/C
vdp_box: equ 0x48e3	; rectangle outline: H=X L=Y D=width E=height C=colour
vdp_line_v_save: equ 0x48fd	; vdp_line_v preserving HL/DE/BC
vdp_line_h_save: equ 0x4907	; vdp_line_h preserving HL/DE/BC
vdp_hmmv: equ 0x4911	; HMMV fill: H=X L=Y D=page B=w C=h A=byte (0 = 256)
vdp_hmmc: equ 0x4991	; HMMC: CPU bytes at HL -> rect D,E size B,C page A
glyph_blit_run: equ 0x4a2e	; blit B 8x8 1bpp glyphs at D,E in ink C
glyph_blit: equ 0x4a37	; one glyph: expand to 0xC110 then blit to the bitmap
hud_string_draw: equ 0x4ad2	; HUD/title string at HL (C=0xFF); 0xFE new pos, 0xFF end
hud_string_masked: equ 0x4ad6	; same stream, C=0 (blank glyphs)
hud_string_glyphs: equ 0x4adc	; glyph loop of hud_string_draw
hud_status_str: equ 0x4c07	; HUD SCORE/PLAYER/ENEMY/STAGE vk strings
hud_glyph_blit: equ 0x4aee	; HMMM 8x8 HUD glyph A at DE (atlas Y+0x38; 0 = space)
hud_glyph_run: equ 0x4b07	; B glyphs via hud_glyph_blit + blit_advance_x
tile_blit: equ 0x4b12	; HMMM 8x8 tile A from page-1 atlas to DE page 0
tile_blit_skip0: equ 0x4b24	; LMMM 8x8 tile A (colour-0 skip); title layout
tile_blit_page1: equ 0x4b36	; HMMM 8x8 tile A onto page 1; Konami logo
vram_clear_page1: equ 0x4de0	; HMMV fill page 1 (256x256)
vram_clear_page: equ 0x4de2	; HMMV fill page D (D=0 here) 256x256
attract_run_init: equ 0x4dee	; wipe play RAM, seed stage 1, build screen, HUD
attract_tick: equ 0x4e27	; play_tick + room transition during attract
room_map_load: equ 0x4f8a	; D100 := current room (D000/D001) via room_map_build
playfield_draw: equ 0x4f98	; HMMM 32x22 tiles from D140 onto page 0
psg_init: equ 0x507d	; mixer shadow + fade clear, then sound_halt
sound_halt: equ 0x508c	; point music/sfx tick ptrs at sound_idle
sat_color_fill: equ 0x5642	; 16 bytes at HL and HL+0x40 := C
vram_blit_tile8: equ 0x4a58	; one 8x8 4bpp tile, HL src -> DE VRAM (0x80 stride)
vram_blit_tile_run: equ 0x4a6d	; B consecutive 8x8 tiles, wrapping each 0x80 line
vram_blit_tile16: equ 0x4a82	; one 16x16 4bpp tile (16 rows of 8)
vram_blit_tile16_run: equ 0x4a97	; B consecutive 16x16 tiles, wrapping each 0x80 line
glyph_expand_4bpp: equ 0x4aac	; 8x8 1bpp at HL -> 4bpp scratch 0xC110, ink C
tile_atlas_pos: equ 0x4b48	; tile id A -> H=SX=(A&1F)*8, L=SY=(A&E0)>>2
blit_advance_x: equ 0x4b56	; step D,E one 8x8 cell right, wrap to the next row
hud_draw_all: equ 0x451a	; repaint the whole HUD (labels, counters, meters, icons)
pause_panel_draw: equ 0x449c	; HMMM pause rectangle + PAUSE string (state 11 enter)
pause_panel_restore: equ 0x44bf	; HMMM the pause rectangle back over the playfield
pause_text: equ 0x44b7	; HUD string: PAUSE
panel_frame: equ 0x5d15	; gm_box_clear + vdp_box colour 14 at HL size BC
hud_bcd_draw: equ 0x457f	; BCD at HL, B bytes, glyphs at DE (hearts/lives/price)
draw_stage_hud: equ 0x4542	; draw the HUD STAGE number (0xC411, BCD)
hud_panel_frames: equ 0x454c	; three vdp_box outlines along the top HUD row
hud_bars_redraw: equ 0x45b7	; repaint both HUD meters with their frames
enemy_meter_redraw: equ 0x45ba	; enemy_meter_frame + draw_enemy_meter
health_bar_redraw: equ 0x45c0	; health frame + draw_health_bar
enemy_meter_frame: equ 0x45c6	; clear + border the enemy meter panel (66x6)
health_bar_frame: equ 0x45cf	; clear + border the health bar panel (66x6)
add_score: equ 0x44f5	; add C:D:E (BCD hi:mid:lo) to the 3-byte score at 0xC405-0xC407
main_state_tbl: equ 0x4161	; 14 handlers indexed by C000
state_logo: equ 0x417d	; 0 Konami logo
state_title: equ 0x41a0	; 1 title screen
state_attract: equ 0x41ab	; 2 attract / demo
state_intro: equ 0x41d1	; 3 intro walk-up
state_stage_bridge: equ 0x422c	; 4 build cell, enter play
state_play: equ 0x4257	; 5 in-stage play
state_death: equ 0x4294	; 6 lives? death_respawn : death_game_over
death_respawn: equ 0x429b	; play_hud_reset, replay BGM, main state 4
death_game_over: equ 0x42ab	; BGM 0x8B, then state_game_over
state_game_over: equ 0x42b2	; 7 GAME OVER / F5 continue
state_hub_advance: equ 0x4324	; C409: boss-clear/credits -> hub++ then advance_stage
state_room_trans: equ 0x437e	; 9 C41B: conn_lookup_paged then play_screen_redraw
state_stage_exit: equ 0x438e	; 10 C408: spend white key, advance_stage
state_pause: equ 0x43e1	; C40A: F1 freeze; F1 again resumes play
state_vendor: equ 0x43f7	; 12 C40C whip-hit vendor
vendor_hold: equ 0x4402	; C001=2: wait C004 then vendor_offer_dismiss, back to play
vendor_begin: equ 0x4411	; C001=0: clear C40C, vendor_make_offer, phase_next
state_game_master_menu: equ 0x441b	; 13 GM cartridge menu
restore_enemy_meter: equ 0x461f	; 0xC418 += B, clamp to 0x80
hurt_simon_1: equ 0x4655	; B=1 then damage_health
heal_simon_1: equ 0x4658	; B=1 then restore_health (boss_clear_heal)
damage_enemy_1: equ 0x465d	; B=1 then damage_enemy
damage_enemy: equ 0x4643	; 0xC418 enemy/boss energy -= B (floored at 0)
hurt_simon_contact: equ 0x8173	; Simon -= 2*actor_value_tbl[type].odd on enemy contact (shield halves)
contact_dmg_full: equ 0x819a	; unshielded / backstab: B *= 2
contact_dmg_left: equ 0x8197	; actor left of Simon: facing-left = face-on
contact_dmg_block: equ 0x819f	; face-on red shield: spend a charge
contact_dmg_apply: equ 0x81af	; jp damage_health
hurt_simon_spikes: equ 0x85ad	; Simon -= 8/16 from a C580 spike bar (16 descending, 8 retracting)
spike_dmg_apply: equ 0x85da	; jp damage_health with B=8/16
spike_bar_overlap: equ 0x85e5	; carry if Simon overlaps this C580 bar's 32x8 box
weapon_hit_damage: equ 0x7e33	; whip/sub-weapon damage to enemy 0xC418 (per weapon+type table)
advance_stage: equ 0x434e	; next stage: 0xD000++ (stage), 0xD001=0 (room), bump 0xC410/11, transition 4
room_map_build: equ 0x4fb6	; expand a room's 8x6 metatiles (4x4 tiles ea) into the 0xD100 tile map
frontend_input: equ 0x4398	; after logo/title/attract: SPACE/TRG start, else any press -> title
frontend_to_title: equ 0x43c1	; logo/attract any new-press -> C000=1, title_build
frontend_game_start: equ 0x43cb	; Game Master path: seed E604-E607, C000=13 (menu)
title_build: equ 0x4d4e	; build/redraw the title screen (regional JP vs export logo via 0x002B)
title_load_tiles: equ 0x5a02	; load title glyphs into VRAM (JP kana vs VAMPIRE KILLER by 0x002B)
title_load_intl: equ 0x5a2a	; non-Japanese 0x002B: blit VAMPIRE KILLER glyphs
title_load_finish: equ 0x5a32	; restore play banks
title_castle: equ 0x4c3f	; title_layout: castle emblem (drawn in both regions)
title_logo_jp: equ 0x4c5a	; title_layout: Japanese title "Akumajo Dracula"
title_logo_intl: equ 0x4ca0	; title_layout: export title "VAMPIRE KILLER"
title_prompt_str: equ 0x4d0f	; "KONAMI 1986" / "PUSH SPACE KEY"
play_start_str: equ 0x4d30	; "PLAY START"
game_over_str: equ 0x4d41	; "GAME  OVER"
title_layout_intl: equ 0x4dc3	; non-Japanese 0x002B: VAMPIRE KILLER + castle
title_layout_finish: equ 0x4dd5	; HUD string + vdp_screen_on
; --- Game Master cartridge (Konami's RC-735 cheat cart): detect, pause, menu -
game_master_detect: equ 0x5c99	; boot slot scan: E600=0xFF if a Game Master cart is present
gm_scan_expanded: equ 0x5cbf	; expanded slot -> try all 4 subslots
gm_sig_cmp: equ 0x5cd3	; RDSLT 6 bytes at 0x7FFA in slot C vs game_master_sig (carry = match)
game_master_sig: equ 0x5cf0	; RC-735 ROM tail at CPU 0x7FFA: 00 30 31 13 35 AA
gm_opt_tbl: equ 0x4010	; DW-padded CD option table (GM1 does not parse it)
gm_pause_check: equ 0x40c5	; int_handler pre-pass: STOP pauses, ';' single-steps a frame
gm_psg_save_mute: equ 0x4107	; stash PSG volumes 8-10 in E611-E613, then silence
gm_psg_mute: equ 0x411f	; zero PSG volume registers 8-10
gm_psg_restore: equ 0x4132	; restore PSG volumes from E611-E613
gm_continue_text: equ 0x4300	; extra GAME OVER line: "F5 -> CONTINUE"
gm_continue_key: equ 0x4314	; edge-detected F5 (row 7 bit 1) via E614
gm_menu_draw: equ 0x5cf6	; clear + frame the menu box, print gm_menu_text
gm_menu_clear: equ 0x5d04	; HMMV the menu rectangle (0x20,0x98) 0xC0 x 0x38
gm_box_clear: equ 0x5d0a	; HMMV HL=(x,y) BC=(w,h) to 0, preserving the args
gm_menu_text: equ 0x5d1d	; "---MENU---" / START GAME / MODIFY STAGE / MODIFY PLAYER
gm_prompt_stage: equ 0x5d68	; draw "STAGE NUMBER=" + the E605 digits
gm_stage_text: equ 0x5d79	; "STAGE NUMBER=" ('?' glyph is an equals sign)
gm_prompt_player: equ 0x5d89	; draw "PLAYER NUMBER=" + the E607 digits
gm_prompt_draw: equ 0x5d97	; clear the item rows, then print the caption at HL
gm_player_text: equ 0x5d9f	; "PLAYER NUMBER="
gm_prompt_clear: equ 0x5db0	; HMMV the three item rows (0x24,0xB0) 0xB8 x 0x18
gm_digit_entry: equ 0x5db9	; digit keys -> E60F BCD accumulator, reprint, E60E binary
gm_bit_to_digit: equ 0x5de8	; scan B bits of A, D = index of the set bit (carry = found)
gm_digit_read: equ 0x5dee	; edge-detected digit keys (row 0 + row 1 bits 0-1) via E608/E609
gm_bcd_to_bin: equ 0x5e0f	; E60F two BCD digits -> E60E as tens*10 + ones
gm_confirm_key: equ 0x5e28	; edge-detected RETURN (row 7 bit 7) via E60A
gm_apply_values: equ 0x5e38	; push the typed stage (D000/D002/C411) and lives (C410) into the run
gm_stage_hub_tbl: equ 0x5e71	; byte[stage 0..18] = hub index (0xD002)
gm_menu_move: equ 0x5e84	; move the cursor: E60B +/-1 wrapped to 0-2, redraw the arrow
gm_cursor_erase: equ 0x5ea9	; blank the arrow on item A
gm_cursor_draw: equ 0x5ead	; draw the arrow (glyph 0x4F) on item A
gm_cursor_blit: equ 0x5eaf	; blit glyph B at (0x28, gm_cursor_y[A])
gm_cursor_y: equ 0x5ebc	; per-item cursor row: 0xB0, 0xB8, 0xC0
scenery_load: equ 0x5a50	; unpack scenery_list into 0xE000, vendor index into 0xDE00
scenery_unpack: equ 0x5a63	; expand scenery stream (0xFE/0xFF/0x00) into 0xE000
scenery_list_lookup: equ 0x5a9f	; HL -> scenery stream for stage 0 or hub 0xD002
vendor_offer_id: equ 0x5b12	; vendor attr bits5-2 -> bonus id (DE00 compact)
scenery_vendor_index: equ 0x5ab6	; compact vendors from E000 into DE00 (48 rooms x 4)
scenery_vendors_compact: equ 0x5ade	; one room: attr 11xxxxxx + 0x7F walls -> DE00 via vendor_offer_id
scenery_room_load: equ 0x5b22	; current E000 room -> C470/C500/C5B5
scenery_slots_fill: equ 0x5b28	; mid: B=8 slots into caller DE
scenery_item_xy: equ 0x5b9d	; floor item: pos -> DE, bonus id bits4-0 -> B
scenery_room_ptr: equ 0x5bd6	; HL -> this room's 24-byte slot in 0xE000
scenery_room_ptr_a: equ 0x5bd9	; mid: A already = room index
scenery_stage_ofs: equ 0x5c0b	; stage 1-18: (stage-within-hub)*0x18
scenery_pos_xy: equ 0x5c1d	; pos byte -> C=Y, B=X pixels
read_buttons: equ 0x4bc2	; joystick|kbd row 8 -> A; play C007/C006, title C401/C400
input_edge_play: equ 0x4bb8	; input_edge with HL=0xC007 (play held/edge)
input_edge: equ 0x4bbb	; A=sample, (HL)=held, (HL-1)=rising-edge bits
read_fkeys: equ 0x4bfb	; sample kbd row 6 -> bit0=F1,bit1=F2,bit2=F3 (edge-detected into 0xC00B)
sound_nop: equ 0x50a5	; ret; music start points C016 here so the sfx slot idles
play_sound: equ 0x50a6	; A=id: 0=stop, 1-7F sfx, 80-8F music, FB-FF special
play_sound_clear: equ 0x5131	; zero fade/lock, C0A7=7, then play_sound_exit
play_sound_exit: equ 0x5140	; restore pages 1/2/3 at 0x6000/0x8000/0xA000
sound_ch_template: equ 0x515d	; 20-byte channel block copied onto C01C/C030/C044/C058/C06C/C080
play_sound_sfx: equ 0x5171	; 1..0x7F: reject if locked or lower priority than C096
play_sound_sfx_go: equ 0x5183	; copy template to C058, index sfx_ptr, arm sound_sfx
play_sound_stop: equ 0x51ab	; id 0: sound_halt then play_sound_exit
play_sound_special: equ 0x51b1	; FB-FF dispatcher
play_sound_fd: equ 0x51cb	; 0xFD overlay (C098 bit0, snd_fd_seq)
play_sound_fe: equ 0x5234	; 0xFE restore from 0xFD
play_sound_fb: equ 0x527d	; 0xFB overlay (C098 bit1, snd_fb_seq)
play_sound_fc: equ 0x52d0	; 0xFC restore from 0xFB
credits_font_load: equ 0x53e5	; page seg14/15 and blit ending credits_font + _az
credits_font_blit: equ 0x53e8	; blit only (banks already paged)
hud_font_load: equ 0x53bd	; page seg7/8 and blit hud_font + hud_tile_bf00
hud_cache_load: equ 0x5494	; page-1 caches: bonus HUD, spike bar, keys, candles, vendor 32x32s
vendor_cache_load: equ 0x54f7	; five recolored vendor 32x32s to page-1 Y=0xA0
vendor_recolor_copy: equ 0x5514	; vendor_tiles -> 0xE800, nibble 0xF := (ix+0)
vendor_blit_32: equ 0x554f	; 4x4 of 8x8 from vendor_tile_ptr into VRAM DE
vendor_tile_ptr: equ 0x5575	; 4x4 words in 0xE800 scratch (0xE900 = empty)
vendor_recolor_tbl: equ 0x5595	; 5 cloak colours (magenta/red/grey/white/blue)
vendor_tiles: equ 0xbda7	; 8 x 8x8 4bpp; nibble 0xF is the cloak key (seg10)
logo_font_load: equ 0x5316	; page seg13, blit logo_font, fall into page_play_banks
room_spawner: equ 0x5ebf	; per-frame enemy spawner; spawn_bitmask_ptr[stage][room]
zombie_generator: equ 0x9ced	; room_spawner bit0: rate-gated zombie (actor type 01) spawner
merman_generator: equ 0x9d52	; room_spawner bit1: actor_merman_green type 02 (1 HP)
merman_generator_3: equ 0x9d59	; room_spawner bit2: actor_merman_red type 03 (spit, 2 HP)
hanging_bat_generator: equ 0x9d9e	; room_spawner bit3: hanging bat type 04
flying_skull_generator: equ 0x9dca	; room_spawner bit4: flying skull type 07
ghost_head_generator: equ 0x9ddc	; room_spawner bit5: ghost head type 08
roc_generator: equ 0x9dee	; room_spawner bit6: roc type 0x0F (drops 0x23)
spawn_actor: equ 0x5f24	; alloc a free actor slot (7 @ 0xC800, stride 0x80) + init
spawn_actor_ab: equ 0x5f26	; mid: keep A/B -> CFFA/CFFB (spawn_actor zeros both)
spawn_actor_init: equ 0x5f7e	; init tail of spawn_actor
intro_actors_frame: equ 0x4e9a	; intro: C800 tick + SAT + pattern_shadow_blit
intro_spawn_sky: equ 0x4ea6	; actor_intro_sky at (0xE0, 0x48)
intro_sky_init: equ 0x4eae	; type 0x27 spawn: pose 0x94
intro_sky_go: equ 0x4eba	; type 0x27 tick: leftward drift
intro_spawn_sky_ab: equ 0x4ec7	; actor_intro_sky_a at (0x90,0x38), _b at (0x30,0x68)
intro_sky_ab_init: equ 0x4ed7	; types 0x28/0x29 spawn: pose 0x92
intro_sky_ab_go: equ 0x4f00	; types 0x28/0x29 tick: toggle pose 0x92/0x93
intro_spawn_simon: equ 0x4f1e	; actor_intro_simon at (0xF0, 0xC0)
intro_simon_init: equ 0x4f26	; type 0x2A spawn: pose 0x98
intro_simon_go: equ 0x4f3c	; type 0x2A tick: walk left, then idle
intro_simon_idle: equ 0x4f5e	; X < 0x80: stop, pose 0x97
intro_simon_stride: equ 0x4f67	; walk-cycle pose from ix+13/14
intro_simon_stride_tbl: equ 0x4f86	; shapes 0x98,0x99,0x9A,0x99

; ---- Vampire Killer banked routines (segment 1 @ 0x6000) -----------------
konami_logo_draw: equ 0x6209	; draw Konami logo + seed the top-to-bottom wipe
konami_logo_step: equ 0x6253	; reveal one more row of the logo (poll 0xC422)
object_list_load: equ 0x615b	; page seg14, unpack 3 streams into DB00/DC00/DD00
object_list_unpack: equ 0x6188	; expand (id,attr) stream into 4-byte slots
object_list_lookup: equ 0x61a5	; HL -> this stage's packed object data in seg14
object_list_clear: equ 0x61b0	; clear the 0xDB00 object list
object_list_spawn: equ 0x61c2	; spawn actors from the visible room's 0xDB00 slots
object_list_spawn_loop: equ 0x61e2	; one of 4 slots
object_list_spawn_next: equ 0x6200	; advance to the next 4-byte slot
tile_string_draw: equ 0x6276	; tile-id stream at HL to screen pos DE (FF/FE)
play_hud_reset: equ 0x62d7	; full HP/meter, inv_reset_life, HUD caches, shared sprites, font
play_screen_build: equ 0x62ed	; tileset, palette, spawn, scenery, then play_screen_redraw
play_screen_redraw: equ 0x62fc	; sprites_hide onward (room change / attract)
cell_event_set: equ 0x633a	; CE00 from cell_event_tbl[stage] if room matches
cell_event_tbl: equ 0x6376	; 19 bytes: room<<4 | event; 0xFF = none
intro_scene_build: equ 0x63da	; intro walk-up: intro_tiles + intro_palette + intro_simon/sky
actor_state_reset: equ 0x6389	; clear C470-C6FF + actor/shot lists, reload room
mem_clear_stride: equ 0x63b8	; zero B entries at HL, stride DE
simon_block_clear: equ 0x63be	; clear 0xC420..0xC46F
sprites_hide: equ 0x63cc	; hide all 32 hardware sprites (Y=0xE0)
simon_spawn_pos: equ 0x6409	; Simon Y/X/facing from simon_spawn_tbl[stage]
simon_spawn_tbl: equ 0x6426	; 19 x {Y|facing, X}
pattern_phase_upload: equ 0x6591	; phase-selected pattern rows to VRAM 0xF400
pattern_shadow_blit: equ 0x65ab	; copy 0xD400 shadow (0x280 bytes) to VRAM 0xF400
room_edge_detect: equ 0x7682	; set C41B pending exit from Simon vs screen edges
room_edge_up: equ 0x76ab	; stairs top: wrap Y, pending dir 1
room_edge_down: equ 0x76c3	; bottom: pit death or room_edge_down_go
pit_water_sfx: equ 0x76ea	; stages 2/10 pit: sfx_water_in
room_edge_down_go: equ 0x76ef	; wrap Y to 0x30, pending dir 2
room_edge_left: equ 0x7709	; pending dir 3 if C41E permits
room_edge_right: equ 0x7714	; pending dir 4 if C41F permits
actor_sat_patterns: equ 0x6030	; copy SAT colour/attr init into slot|0x20 cells
spawn_nop: equ 0x602f	; unused spawn-init (types 0x1D/0x25/0x2B): ret
actor_sat_assign: equ 0x604f	; store SAT index D at cell E of slot|0x20
actor_spr_count: equ 0x605f	; byte[type]; spawn indexes as 0x605E+type
actor_sat_pat_ptr: equ 0x608d	; word[type] -> colour/attr stream; spawn uses 0x608B
actor_hp_tbl: equ 0x60e9	; HP[type]; spawn indexes as 0x60E8+type
actor_sat_colors: equ 0x6119	; SAT colour/attr init streams (cell+4)
actor_sat_build: equ 0x644c	; one actor: seg6 shape stream -> SAT block at slot|0x20
shot_sat_emit: equ 0x64ec	; 8 x shot SAT blocks -> 0xD638 hardware shadow
c800_sat_emit: equ 0x64f3	; 7 x C800 SAT blocks -> 0xD638 hardware shadow
actor_sat_emit: equ 0x6508	; one actor SAT block -> 0xD638; colour at 0xD4E0+id*16
lookup_word_tbl: equ 0x6549	; DE = ((word*)DE)[A]  (generic word-table lookup)
frame_vram_refresh: equ 0x6552	; per-frame pattern upload (or pattern_shadow_blit)
credits_tick: equ 0x66c1	; ending credits (CE40 after event 6); 4-step machine
credits_start: equ 0x66d0	; BGM 0x8E + credits_init
credits_next: equ 0x66d8	; CE40++
credits_pump: equ 0x66dd	; credits_frame until CE32
credits_wait: equ 0x66e7	; wait 0x5310, arm CE02
credits_finish: equ 0x66f8	; C409 + D012++ + R23=0
credits_init: equ 0x6719	; credits_font_load, clear CE30-CE34
credits_frame: equ 0x6736	; clock + keyframe + wipe
credits_clock: equ 0x673f	; CE33++ every 4th frame
credits_keyframe: equ 0x674a	; blit credits_script_ptr[CE31] when tick matches
credits_script_done: equ 0x6788	; CE32=1, play_sound 0xFF
credits_script_ptr: equ 0x6795	; 43 words -> seg8 ending + seg5 staff keyframes
credits_wipe: equ 0x6831	; FILVRM 0x80 at (CE33-2)<<7 (clear scrolled-off line)
credits_palette_ramp: equ 0x67eb	; cycle CE39 through credits_ramp_tbl onto pal 6
credits_ramp_tbl: equ 0x6804	; 19-byte triangle for palette index 6
credits_palette_clear: equ 0x6817	; palette index 6 := 0
dracula_eyes_blink: equ 0x681f	; CE38&0x1F: 0x1C closed eyes, 0x1F open
dracula_ce35_tick: equ 0x6875	; DISPATCH_A on CE35: wait / close / open face
dracula_face_close: equ 0x68af	; CE37 anim -> closed mouth (then half composite)
dracula_face_open: equ 0x68cb	; CE37 anim -> half composite then open mouth
dracula_blit_mouth_half: equ 0x68e3	; no mid tile: open mouth 2 on top, closed mouth 1 below
dracula_blit_mouth_closed: equ 0x691b	; mouths 0+1 closed (0xBDD8/0xBE58)
dracula_blit_mouth_open: equ 0x6953	; mouths 2+3 open (0xBED8/0xBF58)
