; z80dasm block map for segment 0 (runs at 0x4000).
; The 16-byte MSX cartridge header is data, not code.
rom_header: start 0x4000 end 0x4010 type bytedata
; 0x4010-0x4027: data table sitting between the header and the interrupt
; handler at 0x4028; decoding it as code mis-aligns the handler.
data_4010: start 0x4010 end 0x4028 type bytedata

; Main state-machine jump table: DISPATCH_A at 0x415e indexes this by the
; primary game state (0xC000).  14 word entries -> state handlers.
main_state_tbl: start 0x4161 end 0x417d type worddata
; Title-screen tile-layout streams (0xFF=end, 0xFE=next row).
title_layout: start 0x4c3f end 0x4d0f type bytedata

; HUD SAT colour/count record consumed by sub_54f7h (IX).
data_5595: start 0x5595 end 0x559A type bytedata
; Projectile weapon RLE pointers + sub_4745h convert records.
weapon_sprite_ptr: start 0x55DE end 0x55F3 type bytedata

; Entity-behaviour jump table: DISPATCH_A at 0x5fd0 indexes this by object
; type (ix+0)-1.  Targets live in the banked 0xA000 ROM, so they can't be
; local labels.  Runs to the end of the segment.
entity_tbl: start 0x5fd3 end 0x6000 type worddata
; New-game C410..C412 seed (lives, STAGE, unread C412).
run_seed_tbl: start 0x44F0 end 0x44F3 type bytedata
; Vendor attr bits5-2 -> bonus id (scenery compact into 0xDE00).
vendor_offer_id: start 0x5B12 end 0x5B22 type bytedata
; 6-byte ROM signature compared at CPU 0x7FFA via RDSLT (boot slot scan).
slot_sig_7ffa: start 0x5CF0 end 0x5CF6 type bytedata
; Stage 1-18 -> (stage-within-hub)*0x18; scenery_room_ptr then <<4.
scenery_stage_ofs: start 0x5C0B end 0x5C1D type bytedata
