; z80dasm block map for segment 3 (bank 0x03, paged at 0xA000).
; Block names avoid colliding with in-source labels (z80dasm emits NAME_start).

; Hanging-bat flap poses (4 right, 4 left) after hanging_bat_flap's ret.
hanging_bat_pose_r: start 0xB17E end 0xB186 type bytedata
; 8x8 atan lut + 64-byte magnitude lut for aim_at_simon.
aim_octant_tbl: start 0xA1A9 end 0xA1E9 type bytedata
aim_scale_tbl: start 0xA1E9 end 0xA229 type bytedata
; Merman walk-period tables.
merman_period_long: start 0xA4FA end 0xA4FE type bytedata
merman_period_short: start 0xA4FE end 0xA502 type bytedata
; Raven flap poses + coast Yvel words.
raven_flap_r: start 0xA7C0 end 0xA7C4 type bytedata
raven_coast_dy_up: start 0xA81A end 0xA82A type bytedata
; Bone-dragon SAT Y wiggle (8 x 4).
bone_dragon_wiggle_ofs: start 0xAAB4 end 0xAAD4 type bytedata
; Axe-knight walk poses 0x5F-0x62.
axe_knight_walk_tbl: start 0xAF2F end 0xAF33 type bytedata
; Roc flap poses 0x6D/0x6E/0x8D.
roc_flap_tbl: start 0xB216 end 0xB219 type bytedata
; Boss-clear orb SAT colours (3 frames x 5 bytes); stage 3 vs everyone else.
orb_sat_s3: start 0xB801 end 0xB810 type bytedata
orb_sat_rest: start 0xB810 end 0xB81F type bytedata
; Orb spin poses 0x8F/90/91/90.
orb_frames: start 0xB85A end 0xB85E type bytedata
